new file mode 100644
index 0000000..3cdc333
--- /dev/null
+++ b/src/auth/jwt-keys.ts
@@ -0,0 +1,26 @@
+import { Injectable, Logger } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import { randomBytes } from 'node:crypto';
+import type { Env } from '../config/env.schema.js';
+
+/**
+ * The signing key and token lifetime, read once. Without JWT_SECRET (allowed outside
+ * production only) the key is random per process, so tokens stop working on restart.
+ * The key itself is never logged.
+ */
+@Injectable()
+export class JwtKeys {
+  readonly secret: string;
+  readonly expiresIn: number;
+
+  constructor(config: ConfigService<Env, true>) {
+    const configured = config.get('JWT_SECRET', { infer: true });
+    if (!configured) {
+      new Logger('Auth').warn(
+        'JWT_SECRET is not set: using a random key; tokens stop working when the app restarts',
+      );
+    }
+    this.secret = configured ?? randomBytes(32).toString('hex');
+    this.expiresIn = config.get('JWT_EXPIRES_IN', { infer: true });
+  }
+}
