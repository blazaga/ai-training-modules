diff --git a/test/support/auth.ts b/test/support/auth.ts
new file mode 100644
index 0000000..39bf71e
--- /dev/null
+++ b/test/support/auth.ts
@@ -0,0 +1,39 @@
+import type { INestApplication } from '@nestjs/common';
+import request from 'supertest';
+import type { App } from 'supertest/types.js';
+
+/** `Authorization: Basic base64(email:password)`, the login request's header. */
+export const basic = (email: string, password: string): string =>
+  `Basic ${Buffer.from(`${email}:${password}`).toString('base64')}`;
+
+/** Trade an email and password for an access token (POST /api/v1/auth/login). */
+export async function login(
+  app: INestApplication<App>,
+  email: string,
+  password: string,
+): Promise<string> {
+  const res = await request(app.getHttpServer())
+    .post('/api/v1/auth/login')
+    .set('Authorization', basic(email, password))
+    .expect(200);
+  return res.body.accessToken as string;
+}
+
+/**
+ * Sign up a user through the public route, log in, and return the headers that
+ * authenticate every later request: `{ Authorization: 'Bearer <token>' }`.
+ */
+export async function signUpAndLogin(
+  app: INestApplication<App>,
+  user: { email: string; name: string; password: string },
+): Promise<{ id: string; headers: Record<string, string> }> {
+  const created = await request(app.getHttpServer())
+    .post('/api/v1/users')
+    .send(user)
+    .expect(201);
+  const token = await login(app, user.email, user.password);
+  return {
+    id: created.body.id as string,
+    headers: { Authorization: `Bearer ${token}` },
+  };
+}
