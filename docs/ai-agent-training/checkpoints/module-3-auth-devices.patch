@@ -0,0 +1,123 @@
+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import type { App } from 'supertest/types.js';
+import { AppModule } from '../src/app.module.js';
+import { configureApp } from '../src/bootstrap/configure-app.js';
+import { basic, login } from './support/auth.js';
+
+/** Basic on POST /auth/login, then a bearer token everywhere else, through the real stack. */
+describe('auth (e2e)', () => {
+  let app: INestApplication<App>;
+  const loginUrl = '/api/v1/auth/login';
+  const me = '/api/v1/auth/me';
+  const ada = {
+    email: 'ada@example.com',
+    name: 'Ada',
+    password: 'correct horse battery',
+  };
+  let adaId: string;
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+    app = moduleRef.createNestApplication();
+    configureApp(app);
+    await app.init();
+    const created = await request(app.getHttpServer())
+      .post('/api/v1/users')
+      .send(ada)
+      .expect(201);
+    adaId = created.body.id;
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('login with Basic returns a bearer token, and the token reaches /me', async () => {
+    const res = await request(app.getHttpServer())
+      .post(loginUrl)
+      .set('Authorization', basic(ada.email, ada.password))
+      .expect(200);
+    expect(res.body).toMatchObject({ tokenType: 'Bearer', expiresIn: 3600 });
+    const me$ = await request(app.getHttpServer())
+      .get(me)
+      .set('Authorization', `Bearer ${res.body.accessToken}`)
+      .expect(200);
+    expect(me$.body).toMatchObject({ id: adaId, email: ada.email });
+    expect(JSON.stringify(me$.body)).not.toMatch(/password/i);
+  });
+
+  it('login matches the email case-insensitively', () =>
+    request(app.getHttpServer())
+      .post(loginUrl)
+      .set('Authorization', basic('ADA@Example.com', ada.password))
+      .expect(200));
+
+  it('every failed login is the SAME 401, with a Basic challenge', async () => {
+    const attempts: (string | undefined)[] = [
+      undefined, // no header
+      'Basic', // bare scheme: passport-http alone would answer 400
+      'Basic !!!not-base64-credentials',
+      basic('nobody@example.com', ada.password),
+      basic(ada.email, 'wrong password'),
+    ];
+    const bodies = new Set<string>();
+    for (const header of attempts) {
+      const req = request(app.getHttpServer()).post(loginUrl);
+      if (header) req.set('Authorization', header);
+      const res = await req.expect(401);
+      expect(res.headers['www-authenticate']).toMatch(/^Basic realm=/);
+      bodies.add(JSON.stringify(res.body));
+    }
+    expect(bodies.size).toBe(1);
+  });
+
+  it('every other route refuses anything but a valid token: the SAME 401, with a Bearer challenge', async () => {
+    const token = await login(app, ada.email, ada.password);
+    const attempts: (string | undefined)[] = [
+      undefined, // no header
+      basic(ada.email, ada.password), // Basic is for /login only
+      'Bearer not-a-jwt',
+      `Bearer ${token.slice(0, -2)}xx`, // signature tampered with
+    ];
+    const bodies = new Set<string>();
+    for (const header of attempts) {
+      const req = request(app.getHttpServer()).get(me);
+      if (header) req.set('Authorization', header);
+      const res = await req.expect(401);
+      expect(res.headers['www-authenticate']).toMatch(/^Bearer realm=/);
+      bodies.add(JSON.stringify(res.body));
+    }
+    expect(bodies.size).toBe(1);
+  });
+
+  it('a disabled user can neither log in nor use a token issued before', async () => {
+    const bob = {
+      email: 'bob@example.com',
+      name: 'Bob',
+      password: 'bob horse battery staple',
+    };
+    const created = await request(app.getHttpServer())
+      .post('/api/v1/users')
+      .send(bob)
+      .expect(201);
+    const bobToken = await login(app, bob.email, bob.password);
+    const adaToken = await login(app, ada.email, ada.password);
+    await request(app.getHttpServer())
+      .patch(`/api/v1/users/${created.body.id}`)
+      .set('Authorization', `Bearer ${adaToken}`)
+      .send({ status: 'disabled' })
+      .expect(200);
+    await request(app.getHttpServer())
+      .post(loginUrl)
+      .set('Authorization', basic(bob.email, bob.password))
+      .expect(401);
+    await request(app.getHttpServer())
+      .get(me)
+      .set('Authorization', `Bearer ${bobToken}`)
+      .expect(401);
+  });
+});
