@@ -0,0 +1,34 @@
+import { Injectable } from '@nestjs/common';
+import { JwtService } from '@nestjs/jwt';
+import type { UserResponse } from '../users/entities/user.entity.js';
+import { JwtKeys } from './jwt-keys.js';
+import type { TokenPayload } from './jwt.strategy.js';
+
+/** What POST /auth/login returns. */
+export interface AccessToken {
+  accessToken: string;
+  tokenType: 'Bearer';
+  /** Seconds until the token expires. */
+  expiresIn: number;
+}
+
+@Injectable()
+export class AuthService {
+  constructor(
+    private readonly jwt: JwtService,
+    private readonly keys: JwtKeys,
+  ) {}
+
+  /** Sign a token for a user who has just proved who they are (Basic, on login). */
+  login(user: UserResponse): AccessToken {
+    const payload: TokenPayload = { sub: user.id, email: user.email };
+    return {
+      accessToken: this.jwt.sign(payload, {
+        secret: this.keys.secret,
+        expiresIn: this.keys.expiresIn,
+      }),
+      tokenType: 'Bearer',
+      expiresIn: this.keys.expiresIn,
+    };
+  }
+}
diff --git a/src/auth/basic-login.guard.ts b/src/auth/basic-login.guard.ts
new file mode 100644
index 0000000..fb39e0a
--- /dev/null
+++ b/src/auth/basic-login.guard.ts
@@ -0,0 +1,32 @@
+import {
+  type ExecutionContext,
+  Injectable,
+  UnauthorizedException,
+} from '@nestjs/common';
+import { AuthGuard } from '@nestjs/passport';
+import type { Response } from 'express';
+import { BASIC_CHALLENGE, UNAUTHORIZED_BODY } from './auth.constants.js';
+
+/**
+ * Guards POST /auth/login with the Basic strategy. Every failure is the same 401
+ * with a Basic challenge, including a malformed header (passport-http alone would
+ * answer that one with 400).
+ */
+@Injectable()
+export class BasicLoginGuard extends AuthGuard('basic') {
+  handleRequest<TUser>(
+    err: unknown,
+    user: TUser | false | null,
+    _info: unknown,
+    context: ExecutionContext,
+  ): TUser {
+    if (err || !user) {
+      context
+        .switchToHttp()
+        .getResponse<Response>()
+        .setHeader('WWW-Authenticate', BASIC_CHALLENGE);
+      throw new UnauthorizedException(UNAUTHORIZED_BODY);
+    }
+    return user;
+  }
+}
diff --git a/src/auth/basic.strategy.ts b/src/auth/basic.strategy.ts
new file mode 100644
index 0000000..9e2db72
--- /dev/null
+++ b/src/auth/basic.strategy.ts
@@ -0,0 +1,33 @@
+import { Injectable } from '@nestjs/common';
+import { PassportStrategy } from '@nestjs/passport';
+import { BasicStrategy as HttpBasicStrategy } from 'passport-http';
+import type { UserResponse } from '../users/entities/user.entity.js';
+import { UserResponseSchema } from '../users/user.schema.js';
+import { UsersService } from '../users/users.service.js';
+
+/**
+ * ch03 step 1: HTTP Basic, with Passport's standard strategy. passport-http reads the
+ * `Authorization: Basic …` header and hands us the email and password; we only say
+ * whether they belong to an active user. It guards ONE route, POST /auth/login.
+ *
+ * Known limit of passport-http 0.3.0 (measured): it keeps only the text between the
+ * first and SECOND colon, so a password containing a colon cannot log in.
+ */
+@Injectable()
+export class BasicStrategy extends PassportStrategy(
+  HttpBasicStrategy,
+  'basic',
+) {
+  constructor(private readonly users: UsersService) {
+    super();
+  }
+
+  /** Returns the PUBLIC user (→ req.user), or null (→ 401 from BasicLoginGuard). */
+  async validate(
+    email: string,
+    password: string,
+  ): Promise<UserResponse | null> {
+    const user = await this.users.verifyCredentials(email, password);
+    return user ? UserResponseSchema.parse(user) : null;
+  }
+}
