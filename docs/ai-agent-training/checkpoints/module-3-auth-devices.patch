diff --git a/src/devices/devices.service.ts b/src/devices/devices.service.ts
new file mode 100644
index 0000000..4dc8556
--- /dev/null
+++ b/src/devices/devices.service.ts
@@ -0,0 +1,153 @@
+import { Inject, Injectable } from '@nestjs/common';
+import type { z } from 'zod';
+import {
+  NotFoundError,
+  RuleViolationError,
+} from '../common/errors/domain-error.js';
+import type { Entity, Page } from '../common/persistence/repository.js';
+import type { CreateDeviceSchema } from './device.schema.js';
+import {
+  generateDeviceKey,
+  generateSecret,
+  hashSecret,
+  secretMatches,
+} from './device-credentials.js';
+import {
+  DEVICES_REPOSITORY,
+  type DevicesRepository,
+} from './devices.repository.js';
+import type { UpdateDeviceDto } from './dto/update-device.dto.js';
+import type { Device } from './entities/device.entity.js';
+
+/** A device together with its secret: returned by provision and rotate, never again. */
+export interface DeviceWithSecret {
+  device: Device;
+  secret: string;
+}
+
+/**
+ * Business logic for devices. Shape rules (types, lengths, enums) live in the
+ * schema. Only rules that need state or more than one field belong here, and
+ * they fail by throwing a DomainError, never by returning a flag.
+ */
+@Injectable()
+export class DevicesService {
+  constructor(
+    @Inject(DEVICES_REPOSITORY) private readonly repo: DevicesRepository,
+  ) {}
+
+  /**
+   * Create a device for its owner, ready to use: active, with a new key and secret.
+   * The secret is returned here ONCE; only its hash is stored (spec).
+   */
+  // `input` is typed as the parsed payload, not the DTO class: spreading a class instance
+  // is flagged by lint (no-misused-spread), and the pipe hands over a plain object anyway.
+  async provision(
+    ownerId: string,
+    input: z.infer<typeof CreateDeviceSchema>,
+  ): Promise<DeviceWithSecret> {
+    const secret = generateSecret();
+    const stored: Omit<Device, keyof Entity> = {
+      ...input,
+      ownerUserId: ownerId, // the creating user owns it
+      status: 'active',
+      deviceKey: generateDeviceKey(),
+      secretHash: hashSecret(secret),
+      secretLast4: secret.slice(-4),
+      secretRotatedAt: null,
+      lastUsedAt: null,
+      archivedAt: null,
+    };
+    return { device: await this.repo.create(stored), secret };
+  }
+
+  findPage(
+    ownerId: string,
+    limit: number,
+    offset: number,
+  ): Promise<Page<Device>> {
+    return this.repo.findPageByOwner(ownerId, limit, offset);
+  }
+
+  /**
+   * Scoped to the owner. Another user's device is NOT FOUND (404), not
+   * forbidden, so device ids cannot be probed. Every method below goes through here.
+   */
+  async findOne(ownerId: string, id: string): Promise<Device> {
+    const found = await this.repo.findById(id);
+    if (!found || found.ownerUserId !== ownerId) {
+      throw new NotFoundError('Device', id);
+    }
+    return found;
+  }
+
+  async update(
+    ownerId: string,
+    id: string,
+    patch: UpdateDeviceDto,
+  ): Promise<Device> {
+    const current = await this.findOne(ownerId, id);
+    // Spec R3: an archived device cannot be edited.
+    if (current.status === 'archived') {
+      throw new RuleViolationError('An archived device cannot be edited');
+    }
+    const updated = await this.repo.update(id, patch);
+    if (!updated) throw new NotFoundError('Device', id);
+    return updated;
+  }
+
+  /**
+   * Spec R4: DELETE archives (a soft delete). The row stays, with `status: archived`
+   * and `archivedAt`, and its key stops working at once. Archiving twice is a no-op.
+   */
+  async remove(ownerId: string, id: string): Promise<void> {
+    const current = await this.findOne(ownerId, id);
+    if (current.status === 'archived') return;
+    const archived = await this.repo.update(id, {
+      status: 'archived',
+      archivedAt: new Date().toISOString(),
+    });
+    if (!archived) throw new NotFoundError('Device', id);
+  }
+
+  /**
+   * Replace the secret; the key stays the same. The old secret stops working
+   * immediately, because only the new hash is stored and nothing is cached.
+   */
+  async rotate(ownerId: string, id: string): Promise<DeviceWithSecret> {
+    const current = await this.findOne(ownerId, id);
+    if (current.status === 'archived') {
+      // Spec R2
+      throw new RuleViolationError('An archived device cannot be rotated');
+    }
+    const secret = generateSecret();
+    const device = await this.repo.update(id, {
+      secretHash: hashSecret(secret),
+      secretLast4: secret.slice(-4),
+      secretRotatedAt: new Date().toISOString(),
+    });
+    if (!device) throw new NotFoundError('Device', id);
+    return { device, secret };
+  }
+
+  /** A decoy hash, so an unknown key costs the same comparison work. */
+  private readonly decoyHash = hashSecret(generateSecret());
+
+  /**
+   * The ACTIVE device these credentials belong to, or undefined. Used by the MCP
+   * middleware (ch09). Every failure looks the same to the caller.
+   */
+  async verifyDeviceKey(
+    deviceKey: string,
+    secret: string,
+  ): Promise<Device | undefined> {
+    const device = await this.repo.findByDeviceKey(deviceKey);
+    const ok = secretMatches(secret, device?.secretHash ?? this.decoyHash);
+    if (!device || !ok || device.status !== 'active') return undefined;
+    return (
+      (await this.repo.update(device.id, {
+        lastUsedAt: new Date().toISOString(),
+      })) ?? undefined
+    );
+  }
+}
