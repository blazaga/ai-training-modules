+++ b/src/auth/auth.controller.ts
@@ -0,0 +1,32 @@
+import { Controller, Get, HttpCode, Post, UseGuards } from '@nestjs/common';
+import { ApiTags } from '@nestjs/swagger';
+import type { UserResponse } from '../users/entities/user.entity.js';
+import { type AccessToken, AuthService } from './auth.service.js';
+import { BasicLoginGuard } from './basic-login.guard.js';
+import { CurrentUser } from './current-user.decorator.js';
+import { Public } from './public.decorator.js';
+
+/** Routes: /api/v1/auth */
+@ApiTags('auth')
+@Controller('auth')
+export class AuthController {
+  constructor(private readonly auth: AuthService) {}
+
+  /**
+   * Trade Basic credentials for an access token. @Public() takes the route out of the
+   * global JWT guard; BasicLoginGuard checks the email and password instead.
+   */
+  @Public()
+  @UseGuards(BasicLoginGuard)
+  @Post('login')
+  @HttpCode(200)
+  login(@CurrentUser() user: UserResponse): AccessToken {
+    return this.auth.login(user);
+  }
+
+  /** Who am I? Needs a bearer token, like every route that is not @Public(). */
+  @Get('me')
+  me(@CurrentUser() user: UserResponse): UserResponse {
+    return user;
+  }
+}
diff --git a/src/auth/auth.module.ts b/src/auth/auth.module.ts
new file mode 100644
index 0000000..03cf7c3
--- /dev/null
+++ b/src/auth/auth.module.ts
@@ -0,0 +1,29 @@
+import { Module } from '@nestjs/common';
+import { APP_GUARD } from '@nestjs/core';
+import { JwtModule } from '@nestjs/jwt';
+import { PassportModule } from '@nestjs/passport';
+import { UsersModule } from '../users/users.module.js';
+import { AuthController } from './auth.controller.js';
+import { AuthService } from './auth.service.js';
+import { BasicStrategy } from './basic.strategy.js';
+import { JwtAuthGuard } from './jwt-auth.guard.js';
+import { JwtKeys } from './jwt-keys.js';
+import { JwtStrategy } from './jwt.strategy.js';
+
+/**
+ * Two strategies, one job each: Basic proves who you are on POST /auth/login and
+ * gets you a token; the token (JWT) authenticates every other request. Registering
+ * JwtAuthGuard as APP_GUARD makes EVERY route authenticated; opt out with @Public().
+ */
+@Module({
+  imports: [UsersModule, PassportModule, JwtModule.register({})],
+  controllers: [AuthController],
+  providers: [
+    JwtKeys,
+    AuthService,
+    BasicStrategy,
+    JwtStrategy,
+    { provide: APP_GUARD, useClass: JwtAuthGuard },
+  ],
+})
+export class AuthModule {}
