@@ -0,0 +1,38 @@
+import { Injectable } from '@nestjs/common';
+import { PassportStrategy } from '@nestjs/passport';
+import { ExtractJwt, Strategy } from 'passport-jwt';
+import type { UserResponse } from '../users/entities/user.entity.js';
+import { UserResponseSchema } from '../users/user.schema.js';
+import { UsersService } from '../users/users.service.js';
+import { JwtKeys } from './jwt-keys.js';
+
+/** What a token carries: the user's id (`sub`) and nothing secret. */
+export interface TokenPayload {
+  sub: string;
+  email: string;
+}
+
+/**
+ * ch03 step 2: `Authorization: Bearer <token>`. passport-jwt checks the signature and
+ * the expiry; we then look the user up, so a token stops working as soon as its user
+ * is gone or no longer active.
+ */
+@Injectable()
+export class JwtStrategy extends PassportStrategy(Strategy, 'jwt') {
+  constructor(
+    keys: JwtKeys,
+    private readonly users: UsersService,
+  ) {
+    super({
+      jwtFromRequest: ExtractJwt.fromAuthHeaderAsBearerToken(),
+      secretOrKey: keys.secret,
+      ignoreExpiration: false,
+    });
+  }
+
+  /** Returns the PUBLIC user (→ req.user), or null (→ 401 from JwtAuthGuard). */
+  async validate(payload: TokenPayload): Promise<UserResponse | null> {
+    const user = await this.users.findOne(payload.sub).catch(() => undefined);
+    return user?.status === 'active' ? UserResponseSchema.parse(user) : null;
+  }
+}
