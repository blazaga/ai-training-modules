+import {
+  NotFoundError,
+  RuleViolationError,
+} from '../common/errors/domain-error.js';
+import { connectInMemory, type Connection } from '../database/connect.js';
+import { DrizzleDevicesRepository } from './devices.drizzle-repository.js';
+import { DevicesService } from './devices.service.js';
+import { devices } from './devices.table.js';
+import { users } from '../users/users.table.js';
+
+/**
+ * Unit tests against a REAL database (SQLite in memory, migrated): the
+ * repository's SQL is exercised, not mocked. One database per file.
+ */
+describe('DevicesService', () => {
+  let connection: Connection;
+  let service: DevicesService;
+
+  // Parsed shape (defaults applied), as the pipe hands it to the service.
+  const valid = { name: 'Sensor 1', description: '' };
+
+  /** Two real users: devices.owner_user_id is a foreign key. */
+  let owner: string;
+  let stranger: string;
+
+  beforeAll(async () => {
+    connection = await connectInMemory();
+    const [a, b] = await connection.db
+      .insert(users)
+      .values([
+        { email: 'owner@example.com', name: 'Owner', passwordHash: 'x' },
+        { email: 'stranger@example.com', name: 'Stranger', passwordHash: 'x' },
+      ])
+      .returning({ id: users.id });
+    owner = a.id;
+    stranger = b.id;
+  });
+
+  afterAll(async () => {
+    await connection.close();
+  });
+
+  beforeEach(async () => {
+    await connection.db.delete(devices);
+    service = new DevicesService(new DrizzleDevicesRepository(connection.db));
+  });
+
+  it('provisions and reads back a device', async () => {
+    const { device } = await service.provision(owner, valid);
+    await expect(service.findOne(owner, device.id)).resolves.toEqual(device);
+  });
+
+  it('throws NotFoundError for an unknown id', async () => {
+    await expect(
+      service.findOne(owner, '00000000-0000-4000-8000-000000000000'),
+    ).rejects.toBeInstanceOf(NotFoundError);
+  });
+
+  describe('ownership', () => {
+    it("another user's device is NOT FOUND, for every operation", async () => {
+      const { device } = await service.provision(owner, valid);
+      for (const attempt of [
+        () => service.findOne(stranger, device.id),
+        () => service.update(stranger, device.id, { name: 'x' }),
+        () => service.remove(stranger, device.id),
+        () => service.rotate(stranger, device.id),
+      ]) {
+        await expect(attempt()).rejects.toBeInstanceOf(NotFoundError);
+      }
+    });
+
+    it('lists only the caller’s devices', async () => {
+      await service.provision(owner, valid);
+      await service.provision(stranger, valid);
+      const mine = await service.findPage(owner, 20, 0);
+      expect(mine.total).toBe(1);
+      expect(mine.items.every((d) => d.ownerUserId === owner)).toBe(true);
+    });
+  });
+
+  describe('provision and credentials', () => {
+    it('a provisioned device is active, with a key; the secret is returned once and only its hash is stored', async () => {
+      const { device, secret } = await service.provision(owner, valid);
+      expect(device.status).toBe('active');
+      expect(device.deviceKey).toMatch(/^DK[A-Z2-7]{16}$/);
+      expect(secret).toMatch(/^dsk_/);
+      const stored = await service.findOne(owner, device.id);
+      expect(stored.secretHash).not.toContain(secret.slice(4));
+      expect(stored.secretLast4).toBe(secret.slice(-4));
+      expect(JSON.stringify(stored)).not.toContain(secret);
+    });
+
+    it('the key and secret authenticate; success records lastUsedAt', async () => {
+      const { device, secret } = await service.provision(owner, valid);
+      const verified = await service.verifyDeviceKey(device.deviceKey!, secret);
+      expect(verified?.id).toBe(device.id);
+      expect(verified?.lastUsedAt).not.toBeNull();
+    });
+
+    it('rotation keeps the key and invalidates the old secret IMMEDIATELY', async () => {
+      const first = await service.provision(owner, valid);
+      const second = await service.rotate(owner, first.device.id);
+      expect(second.device.deviceKey).toBe(first.device.deviceKey);
+      await expect(
+        service.verifyDeviceKey(first.device.deviceKey!, first.secret),
+      ).resolves.toBeUndefined();
+      await expect(
+        service.verifyDeviceKey(first.device.deviceKey!, second.secret),
+      ).resolves.toBeDefined();
+    });
+
+    it('an unknown key or a wrong secret is undefined', async () => {
+      const { device } = await service.provision(owner, valid);
+      await expect(
+        service.verifyDeviceKey('DKAAAAAAAAAAAAAAAA', 'dsk_x'),
+      ).resolves.toBeUndefined();
+      await expect(
+        service.verifyDeviceKey(device.deviceKey!, 'dsk_wrong'),
+      ).resolves.toBeUndefined();
+    });
+
+    it('R2: an archived device cannot be rotated', async () => {
+      const { device } = await service.provision(owner, valid);
+      await service.remove(owner, device.id);
+      await expect(service.rotate(owner, device.id)).rejects.toBeInstanceOf(
+        RuleViolationError,
+      );
+    });
+  });
+
