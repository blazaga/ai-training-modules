+/** The 401 every auth failure returns: one body, so failures cannot be told apart. */
+export const UNAUTHORIZED_BODY = {
+  statusCode: 401,
+  error: 'Unauthorized',
+  message: 'Invalid credentials',
+} as const;
+
+/** The challenge sent with a failed login: Basic, on POST /auth/login only. */
+export const BASIC_CHALLENGE = 'Basic realm="nest-ai-starter", charset="UTF-8"';
+
+/** The challenge sent with every other 401: the API expects a bearer token. */
+export const BEARER_CHALLENGE = 'Bearer realm="nest-ai-starter"';
