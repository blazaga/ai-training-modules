@@ -0,0 +1,19 @@
+import type { McpContext } from '@rekog/mcp-nest';
+import { RuleViolationError } from '../common/errors/domain-error.js';
+import type { Device } from '../devices/entities/device.entity.js';
+import type { DeviceRequest } from './device-auth.middleware.js';
+
+/**
+ * ch09/ch10: the device making this call, as authenticated by deviceAuth. Over
+ * stdio there is no request and so no device: the call fails CLOSED with a tool
+ * error (call this inside runTool), never falls back to "everyone's data".
+ */
+export function requireDevice(ctx: McpContext): Device {
+  const device = ctx.getRawRequest<DeviceRequest>()?.mcpDevice;
+  if (!device) {
+    throw new RuleViolationError(
+      'No device identity: this transport is not authenticated',
+    );
+  }
+  return device;
+}
