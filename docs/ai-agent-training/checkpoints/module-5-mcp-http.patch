diff --git a/test/mcp-http.e2e-spec.ts b/test/mcp-http.e2e-spec.ts
new file mode 100644
index 0000000..5926a6c
--- /dev/null
+++ b/test/mcp-http.e2e-spec.ts
@@ -0,0 +1,125 @@
+import type { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import {
+  Client,
+  StreamableHTTPClientTransport,
+} from '@modelcontextprotocol/client';
+import { request } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { AppModule } from '../src/app.module.js';
+import { attachMcp } from '../src/bootstrap/attach-mcp.js';
+import { configureApp } from '../src/bootstrap/configure-app.js';
+
+type TextResult = { content: { text: string }[]; isError?: boolean };
+
+/**
+ * ch08: the MCP tools over Streamable HTTP on a real listening server. Module 6 adds
+ * device authentication; until then /mcp is open, and the first test says so.
+ */
+describe('MCP over Streamable HTTP (e2e)', () => {
+  let app: INestApplication;
+  let url: string;
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+    app = moduleRef.createNestApplication();
+    configureApp(app);
+    await attachMcp(app);
+    await app.listen(0);
+    const { port } = app.getHttpServer().address() as AddressInfo;
+    url = `http://localhost:${port}/mcp`;
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  const post = (body: object, headers: Record<string, string> = {}) =>
+    fetch(url, {
+      method: 'POST',
+      headers: {
+        'content-type': 'application/json',
+        accept: 'application/json, text/event-stream',
+        ...headers,
+      },
+      body: JSON.stringify(body),
+    });
+  const ping = { jsonrpc: '2.0', id: 1, method: 'ping' };
+
+  it('NO authentication yet: a real MCP client lists and calls tools without credentials', async () => {
+    // The security finding this module ends on; module 6 closes it with device auth.
+    const client = new Client({ name: 'e2e', version: '1.0.0' });
+    await client.connect(new StreamableHTTPClientTransport(new URL(url)));
+    const { tools } = await client.listTools();
+    expect(tools.map((t) => t.name)).toEqual(
+      expect.arrayContaining(['create-note', 'list-notes']),
+    );
+    const result = (await client.callTool({
+      name: 'create-note',
+      arguments: { title: 'over HTTP' },
+    })) as TextResult;
+    expect(JSON.parse(result.content[0].text).title).toBe('over HTTP');
+    await client.close();
+  });
+
+  it('responses are Server-Sent Events: `event: message` + `data: <JSON-RPC>`', async () => {
+    const res = await post({
+      jsonrpc: '2.0',
+      id: 1,
+      method: 'initialize',
+      params: {
+        protocolVersion: '2025-06-18',
+        capabilities: {},
+        clientInfo: { name: 'raw', version: '1' },
+      },
+    });
+    expect(res.status).toBe(200);
+    expect(res.headers.get('content-type')).toContain('text/event-stream');
+    const text = await res.text();
+    expect(text).toMatch(/^event: message\ndata: /);
+    expect(JSON.parse(text.split('data: ')[1])).toMatchObject({
+      jsonrpc: '2.0',
+      id: 1,
+      result: { serverInfo: { name: 'nest-ai-starter' } },
+    });
+  });
+
+  it('is mounted at /mcp, OUTSIDE the /api prefix', async () => {
+    const res = await fetch(url.replace('/mcp', '/api/mcp'), {
+      method: 'POST',
+    });
+    expect(res.status).toBe(404);
+  });
+
+  it('rejects a foreign Host header (DNS-rebinding protection): 403', async () => {
+    // NOT fetch: under the Fetch spec `Host` is a forbidden header, and Node's
+    // fetch silently replaces it (measured). node:http sends it as written.
+    // The same request on both, so the Host is the ONLY difference.
+    const status = (host: string) =>
+      new Promise<number | undefined>((resolve, reject) => {
+        const req = request(
+          {
+            host: 'localhost',
+            port: new URL(url).port,
+            path: '/mcp',
+            method: 'POST',
+            headers: {
+              host,
+              'content-type': 'application/json',
+              accept: 'application/json, text/event-stream',
+            },
+          },
+          (res) => {
+            res.resume();
+            resolve(res.statusCode);
+          },
+        );
+        req.on('error', reject);
+        req.end(JSON.stringify(ping));
+      });
+    expect(await status(`localhost:${new URL(url).port}`)).toBe(200);
+    expect(await status('evil.example')).toBe(403);
+  });
+});
