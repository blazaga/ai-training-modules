@@ -0,0 +1,31 @@
+import type { Page, Repository } from '../common/persistence/repository.js';
+import type { User } from '../users/entities/user.entity.js';
+import type { Note } from './entities/note.entity.js';
+
+/** Injection token: services depend on the port, never on a storage class. */
+export const NOTES_REPOSITORY = Symbol('NOTES_REPOSITORY');
+
+/** List filters (specs/notes.md, Listing); absent ones do not filter. */
+export interface NoteFilter {
+  ownerId?: string;
+  sharedWith?: string;
+  status?: Note['status'];
+}
+
+/** The generic CRUD port plus the lookups this resource needs. */
+export interface NotesRepository extends Repository<Note> {
+  /** A page of notes matching every given filter. */
+  findFiltered(
+    filter: NoteFilter,
+    limit: number,
+    offset: number,
+  ): Promise<Page<Note>>;
+  /** A user by id (owner check R1, share target). */
+  findUser(id: string): Promise<User | undefined>;
+  /** The users a note is shared with, oldest share first. */
+  findSharedUsers(noteId: string): Promise<User[]>;
+  /** Share a note with a user; sharing twice is a no-op. */
+  share(noteId: string, userId: string): Promise<void>;
+  /** Unshare; false if it was not shared with that user. */
+  unshare(noteId: string, userId: string): Promise<boolean>;
+}
diff --git a/src/notes/notes.service.spec.ts b/src/notes/notes.service.spec.ts
new file mode 100644
index 0000000..f395409
--- /dev/null
+++ b/src/notes/notes.service.spec.ts
@@ -0,0 +1,170 @@
+import {
+  NotFoundError,
+  RuleViolationError,
+} from '../common/errors/domain-error.js';
+import { users } from '../users/users.table.js';
+import type { CreateNoteDto } from './dto/create-note.dto.js';
+import { connectInMemory, type Connection } from '../database/connect.js';
+import { DrizzleNotesRepository } from './notes.drizzle-repository.js';
+import { NotesService } from './notes.service.js';
+import { notes } from './notes.table.js';
+
+/**
+ * Unit tests against a REAL database (SQLite in memory, migrated): the
+ * repository's SQL is exercised, not mocked. One database per file.
+ */
+describe('NotesService', () => {
+  let connection: Connection;
+  let service: NotesService;
+
+  const missing = '00000000-0000-4000-8000-000000000000';
+  let ownerId: string;
+  let friendId: string;
+  /** A minimal valid payload, as the validation pipe would hand it over. */
+  let valid: CreateNoteDto;
+
+  beforeAll(async () => {
+    connection = await connectInMemory();
+  });
+
+  afterAll(async () => {
+    await connection.close();
+  });
+
+  beforeEach(async () => {
+    await connection.db.delete(notes);
+    await connection.db.delete(users);
+    const [owner, friend] = await connection.db
+      .insert(users)
+      .values([
+        { email: 'owner@example.com', name: 'Owner' },
+        { email: 'friend@example.com', name: 'Friend' },
+      ])
+      .returning();
+    ownerId = owner.id;
+    friendId = friend.id;
+    valid = {
+      ownerId,
+      title: 'Buy milk',
+      body: '',
+      status: 'open',
+      dueAt: null,
+    };
+    service = new NotesService(new DrizzleNotesRepository(connection.db));
+  });
+
+  it('creates and reads back one note', async () => {
+    const created = await service.create(valid);
+    await expect(service.findOne(created.id)).resolves.toEqual(created);
+  });
+
+  it('throws NotFoundError for an unknown id', async () => {
+    await expect(
+      service.findOne('00000000-0000-4000-8000-000000000000'),
+    ).rejects.toBeInstanceOf(NotFoundError);
+  });
+
+  it('removes one note', async () => {
+    const created = await service.create(valid);
+    await service.remove(created.id);
+    await expect(service.findOne(created.id)).rejects.toBeInstanceOf(
+      NotFoundError,
+    );
+  });
+
+  describe('R1: the owner must be an existing user', () => {
+    it('creates a note for an existing owner', async () => {
+      await expect(service.create(valid)).resolves.toMatchObject({ ownerId });
+    });
+
+    it('refuses an unknown owner with RuleViolationError', async () => {
+      await expect(
+        service.create({ ...valid, ownerId: missing }),
+      ).rejects.toBeInstanceOf(RuleViolationError);
+    });
+  });
+
+  describe('R2: a done note can only be reopened', () => {
+    it('allows editing an open note', async () => {
+      const note = await service.create(valid);
+      await expect(
+        service.update(note.id, { title: 'Changed' }),
+      ).resolves.toMatchObject({ title: 'Changed' });
+    });
+
+    it('refuses editing a done note with RuleViolationError', async () => {
+      const note = await service.create({ ...valid, status: 'done' });
+      await expect(
+        service.update(note.id, { title: 'Changed' }),
+      ).rejects.toBeInstanceOf(RuleViolationError);
+      await expect(
+        service.update(note.id, { status: 'open', title: 'Changed' }),
+      ).rejects.toBeInstanceOf(RuleViolationError);
+      await expect(service.findOne(note.id)).resolves.toEqual(note);
+    });
+
+    it('allows reopening a done note, then editing it', async () => {
+      const note = await service.create({ ...valid, status: 'done' });
+      await expect(
+        service.update(note.id, { status: 'open' }),
+      ).resolves.toMatchObject({ status: 'open' });
+      await expect(
+        service.update(note.id, { title: 'Changed' }),
+      ).resolves.toMatchObject({ title: 'Changed' });
+    });
+  });
+
+  describe('sharing', () => {
+    it('shares idempotently and lists the users', async () => {
+      const note = await service.create(valid);
+      await service.share(note.id, friendId);
+      await service.share(note.id, friendId);
+      const shared = await service.sharedWith(note.id);
+      expect(shared.map((u) => u.id)).toEqual([friendId]);
+    });
+
+    it('R4: refuses sharing with the owner (RuleViolationError)', async () => {
+      const note = await service.create(valid);
+      await expect(service.share(note.id, ownerId)).rejects.toBeInstanceOf(
+        RuleViolationError,
+      );
+      await expect(service.sharedWith(note.id)).resolves.toEqual([]);
+    });
+
+    it('404s an unknown user or note', async () => {
+      const note = await service.create(valid);
+      await expect(service.share(note.id, missing)).rejects.toBeInstanceOf(
+        NotFoundError,
+      );
+      await expect(service.share(missing, friendId)).rejects.toBeInstanceOf(
+        NotFoundError,
+      );
+    });
+
+    it('unshares once, then 404s', async () => {
+      const note = await service.create(valid);
+      await service.share(note.id, friendId);
+      await service.unshare(note.id, friendId);
+      await expect(service.unshare(note.id, friendId)).rejects.toBeInstanceOf(
+        NotFoundError,
+      );
+    });
+
+    it('filters the list by ownerId, sharedWith and status (AND)', async () => {
+      const open = await service.create(valid);
+      const done = await service.create({ ...valid, status: 'done' });
+      await service.share(open.id, friendId);
+      await service.share(done.id, friendId);
+      // Order-agnostic on purpose: both notes can share a created_at, and the tiebreak is the
+      // random id, so creation order is not list order (measured: 3 of 20 runs failed).
+      const ids = async (filter: object) =>
+        (await service.findPage(filter, 20, 0)).items.map((n) => n.id).sort();
+      expect(await ids({ ownerId })).toEqual([open.id, done.id].sort());
+      expect(await ids({ ownerId: friendId })).toEqual([]);
+      expect(await ids({ sharedWith: friendId, status: 'done' })).toEqual([
+        done.id,
+      ]);
+      expect((await service.findPage({ status: 'open' }, 20, 0)).total).toBe(1);
+    });
+  });
+});
diff --git a/src/notes/notes.service.ts b/src/notes/notes.service.ts
new file mode 100644
index 0000000..8e0fe49
--- /dev/null
+++ b/src/notes/notes.service.ts
@@ -0,0 +1,114 @@
+import { Inject, Injectable } from '@nestjs/common';
+import {
+  NotFoundError,
+  RuleViolationError,
+} from '../common/errors/domain-error.js';
+import type { User } from '../users/entities/user.entity.js';
+import type { Entity, Page } from '../common/persistence/repository.js';
+import {
+  NOTES_REPOSITORY,
+  type NoteFilter,
+  type NotesRepository,
+} from './notes.repository.js';
+import type { CreateNoteDto } from './dto/create-note.dto.js';
+import type { UpdateNoteDto } from './dto/update-note.dto.js';
+import type { Note } from './entities/note.entity.js';
+
+/**
+ * Business logic for notes. Shape rules (types, lengths, enums) live in the
+ * schema. Only rules that need state or more than one field belong here, and
+ * they fail by throwing a DomainError, never by returning a flag.
+ */
+@Injectable()
+export class NotesService {
+  constructor(
+    @Inject(NOTES_REPOSITORY) private readonly repo: NotesRepository,
+  ) {}
+
+  async create(input: CreateNoteDto): Promise<Note> {
+    // R1: the owner must be an existing user (422, not 404: the note is what is created).
+    if (!(await this.repo.findUser(input.ownerId))) {
+      throw new RuleViolationError(`Owner ${input.ownerId} does not exist`, {
+        ownerId: input.ownerId,
+      });
+    }
+    return this.repo.create(await this.toStored(input));
+  }
+
+  /** The create payload in its STORED shape: write-only inputs become private fields. */
+  private toStored(
+    input: CreateNoteDto,
+  ): Promise<Omit<Note, keyof Entity>> | Omit<Note, keyof Entity> {
+    // No write-only inputs.
+    return input;
+  }
+
+  findPage(
+    filter: NoteFilter,
+    limit: number,
+    offset: number,
+  ): Promise<Page<Note>> {
+    return this.repo.findFiltered(filter, limit, offset);
+  }
+
+  async findOne(id: string): Promise<Note> {
+    const found = await this.repo.findById(id);
+    if (!found) throw new NotFoundError('Note', id);
+    return found;
+  }
+
+  async update(id: string, patch: UpdateNoteDto): Promise<Note> {
+    const current = await this.findOne(id);
+    // R2: a done note is read-only; the one PATCH it accepts is { status: 'open' }.
+    // ownerId never reaches here: UpdateNoteSchema does not declare it.
+    const reopensOnly =
+      Object.keys(patch).length === 1 && patch.status === 'open';
+    if (current.status === 'done' && !reopensOnly) {
+      throw new RuleViolationError(
+        'A done note cannot be edited; it can only be reopened with { status: "open" }',
+        { id },
+      );
+    }
+    const updated = await this.repo.update(id, patch);
+    if (!updated) throw new NotFoundError('Note', id);
+    return updated;
+  }
+
+  async remove(id: string): Promise<void> {
+    const current = await this.findOne(id);
+    // No remove-time rules. Its shares go with it (note_shares cascades).
+    void current;
+    const deleted = await this.repo.delete(id);
+    if (!deleted) throw new NotFoundError('Note', id);
+  }
+
+  /** The users this note is shared with. */
+  async sharedWith(id: string): Promise<User[]> {
+    await this.findOne(id);
+    return this.repo.findSharedUsers(id);
+  }
+
+  /** Share with a user; idempotent. */
+  async share(id: string, userId: string): Promise<void> {
+    const note = await this.findOne(id);
+    if (!(await this.repo.findUser(userId))) {
+      throw new NotFoundError('User', userId);
+    }
+    // R4: never with its own owner.
+    if (note.ownerId === userId) {
+      throw new RuleViolationError('A note cannot be shared with its owner', {
+        id,
+        userId,
+      });
+    }
+    await this.repo.share(id, userId);
+  }
+
+  /** Unshare; 404 if the note was not shared with that user. */
+  async unshare(id: string, userId: string): Promise<void> {
+    await this.findOne(id);
+    if (!(await this.repo.unshare(id, userId))) {
+      throw new NotFoundError('Share', `${id}/${userId}`);
+    }
+  }
+}
