+import type { z } from 'zod';
+import type { NoteResponseSchema, NoteSchema } from '../note.schema.js';
+
+/** Derived from the schemas: never hand-write fields here. */
+export type Note = z.infer<typeof NoteSchema>;
+
+/** A Note without its private fields: the only shape that leaves the API. */
+export type NoteResponse = z.infer<typeof NoteResponseSchema>;
diff --git a/src/notes/note.schema.ts b/src/notes/note.schema.ts
new file mode 100644
index 0000000..4d90030
--- /dev/null
+++ b/src/notes/note.schema.ts
@@ -0,0 +1,77 @@
+import { z } from 'zod';
+import { PageQuerySchema } from '../common/schemas/page-query.schema.js';
+import { patchSchema } from '../common/schemas/patch-schema.js';
+import { createZodDto } from '../common/zod/zod-dto.js';
+
+/**
+ * Single source of truth for a Note AS STORED: validation, TypeScript types
+ * and the OpenAPI schema all derive from these definitions. Change fields HERE only.
+ */
+export const NoteSchema = z.object({
+  id: z.string().uuid(),
+  // Settable on create only: UpdateNoteSchema omits it, so a PATCH has it stripped.
+  ownerId: z.string().uuid(),
+  title: z.string().trim().min(1).max(200),
+  body: z.string().max(10_000).default(''),
+  status: z.enum(['open', 'done']).default('open'),
+  // R3: any offset accepted, stored as UTC toISOString() so SQLite sorts the text.
+  // zod runs every check even after the format fails, so the abort guard keeps
+  // toISOString() from throwing (a 500, measured) on a string Date cannot parse.
+  dueAt: z.iso
+    .datetime({ offset: true })
+    .refine((value) => !Number.isNaN(Date.parse(value)), {
+      message: 'Invalid date',
+      abort: true,
+    })
+    .overwrite((value) => new Date(value).toISOString())
+    .nullable()
+    .default(null),
+  createdAt: z.string().datetime(),
+  updatedAt: z.string().datetime(),
+});
+
+/**
+ * Stored but never RETURNED and never ACCEPTED from a client (a password or
+ * secret hash). Responses are parsed through NoteResponseSchema, which
+ * strips these. A test checks that no response carries them.
+ */
+const PRIVATE = {} as const;
+
+/**
+ * Returned to clients but never ACCEPTED from them: the server sets these, usually
+ * through actions (e.g. `status` only changes via POST /:id/activate).
+ */
+const SERVER_OWNED = {} as const;
+
+/** What every endpoint returns. */
+export const NoteResponseSchema = NoteSchema.omit(PRIVATE);
+
+/**
+ * Client-settable fields, UNREFINED. Zod 4 throws on .omit()/.partial() of a
+ * refined object, so derive from this and attach .refine() last.
+ */
+const NoteFields = NoteSchema.omit({
+  id: true,
+  createdAt: true,
+  updatedAt: true,
+  ...PRIVATE,
+  ...SERVER_OWNED,
+});
+
+/** POST body. */
+export const CreateNoteSchema = NoteFields;
+
+/**
+ * PATCH body: any subset of the create fields, never empty, and WITHOUT defaults
+ * (see patchSchema: .partial() would overwrite stored values with defaults).
+ */
+export const UpdateNoteSchema = patchSchema(NoteFields.omit({ ownerId: true }));
+
+/** GET /notes: the house paging plus optional filters, combined with AND. */
+export const NoteListQuerySchema = PageQuerySchema.extend({
+  ownerId: z.string().uuid().optional(),
+  sharedWith: z.string().uuid().optional(),
+  status: z.enum(['open', 'done']).optional(),
+});
+export type NoteListQuery = z.infer<typeof NoteListQuerySchema>;
+export class NoteListQueryDto extends createZodDto(NoteListQuerySchema) {}
diff --git a/src/notes/notes.controller.ts b/src/notes/notes.controller.ts
new file mode 100644
index 0000000..8e56d2d
--- /dev/null
+++ b/src/notes/notes.controller.ts
@@ -0,0 +1,97 @@
+import {
+  Body,
+  Controller,
+  Delete,
+  Get,
+  HttpCode,
+  HttpStatus,
+  Param,
+  ParseUUIDPipe,
+  Patch,
+  Post,
+  Put,
+  Query,
+} from '@nestjs/common';
+import { ApiTags } from '@nestjs/swagger';
+import type { Page } from '../common/persistence/repository.js';
+import { UserResponseSchema } from '../users/user.schema.js';
+import type { UserResponse } from '../users/entities/user.entity.js';
+import { NoteListQueryDto, NoteResponseSchema } from './note.schema.js';
+import { NotesService } from './notes.service.js';
+import { CreateNoteDto } from './dto/create-note.dto.js';
+import { UpdateNoteDto } from './dto/update-note.dto.js';
+import type { Note, NoteResponse } from './entities/note.entity.js';
+
+/** Strip private fields. Every value this controller returns passes through here. */
+const toResponse = (entity: Note): NoteResponse =>
+  NoteResponseSchema.parse(entity);
+
+/**
+ * HTTP only: parse, delegate, return. No business logic here (it goes in the
+ * service) and no try/catch (DomainExceptionFilter maps errors).
+ * Routes: /api/v1/notes, and /api/v1/notes/:id/shares[/:userId] for sharing
+ */
+@ApiTags('notes')
+@Controller('notes')
+export class NotesController {
+  constructor(private readonly service: NotesService) {}
+
+  @Post()
+  async create(@Body() body: CreateNoteDto): Promise<NoteResponse> {
+    return toResponse(await this.service.create(body));
+  }
+
+  @Get()
+  async findPage(
+    @Query() query: NoteListQueryDto,
+  ): Promise<Page<NoteResponse>> {
+    const { limit, offset, ...filter } = query;
+    const page = await this.service.findPage(filter, limit, offset);
+    return { ...page, items: page.items.map(toResponse) };
+  }
+
+  @Get(':id')
+  async findOne(@Param('id', ParseUUIDPipe) id: string): Promise<NoteResponse> {
+    return toResponse(await this.service.findOne(id));
+  }
+
+  @Patch(':id')
+  async update(
+    @Param('id', ParseUUIDPipe) id: string,
+    @Body() body: UpdateNoteDto,
+  ): Promise<NoteResponse> {
+    return toResponse(await this.service.update(id, body));
+  }
+
+  @Delete(':id')
+  @HttpCode(HttpStatus.NO_CONTENT)
+  remove(@Param('id', ParseUUIDPipe) id: string): Promise<void> {
+    return this.service.remove(id);
+  }
+
+  @Get(':id/shares')
+  async sharedWith(
+    @Param('id', ParseUUIDPipe) id: string,
+  ): Promise<{ items: UserResponse[] }> {
+    const users = await this.service.sharedWith(id);
+    return { items: users.map((u) => UserResponseSchema.parse(u)) };
+  }
+
+  @Put(':id/shares/:userId')
+  @HttpCode(HttpStatus.NO_CONTENT)
+  share(
+    @Param('id', ParseUUIDPipe) id: string,
+    @Param('userId', ParseUUIDPipe) userId: string,
+  ): Promise<void> {
+    return this.service.share(id, userId);
+  }
+
+  @Delete(':id/shares/:userId')
+  @HttpCode(HttpStatus.NO_CONTENT)
+  unshare(
+    @Param('id', ParseUUIDPipe) id: string,
+    @Param('userId', ParseUUIDPipe) userId: string,
+  ): Promise<void> {
+    return this.service.unshare(id, userId);
+  }
+}
diff --git a/src/notes/notes.drizzle-repository.ts b/src/notes/notes.drizzle-repository.ts
new file mode 100644
index 0000000..92295f9
--- /dev/null
+++ b/src/notes/notes.drizzle-repository.ts
@@ -0,0 +1,89 @@
+import { Inject, Injectable } from '@nestjs/common';
+import { and, asc, count, eq, inArray, type SQL } from 'drizzle-orm';
+import type { Page } from '../common/persistence/repository.js';
+import type { User } from '../users/entities/user.entity.js';
+import { users } from '../users/users.table.js';
+import { noteShares } from './note-shares.table.js';
+import { DrizzleRepository } from '../common/persistence/drizzle-repository.js';
+import { DB, type Db } from '../database/database.types.js';
+import type { NoteFilter, NotesRepository } from './notes.repository.js';
+import { notes } from './notes.table.js';
+import type { Note } from './entities/note.entity.js';
+
+/** SQLite storage for notes (drizzle). CRUD comes from DrizzleRepository. */
+@Injectable()
+export class DrizzleNotesRepository
+  extends DrizzleRepository<Note>
+  implements NotesRepository
+{
+  constructor(@Inject(DB) db: Db) {
+    super(db, notes, 'Note');
+  }
+
+  async findFiltered(
+    filter: NoteFilter,
+    limit: number,
+    offset: number,
+  ): Promise<Page<Note>> {
+    const conditions: SQL[] = [];
+    if (filter.ownerId) conditions.push(eq(notes.ownerId, filter.ownerId));
+    if (filter.status) conditions.push(eq(notes.status, filter.status));
+    if (filter.sharedWith) {
+      conditions.push(
+        inArray(
+          notes.id,
+          this.db
+            .select({ noteId: noteShares.noteId })
+            .from(noteShares)
+            .where(eq(noteShares.userId, filter.sharedWith)),
+        ),
+      );
+    }
+    const where = and(...conditions);
+    const [rows, [{ total }]] = await Promise.all([
+      this.db
+        .select()
+        .from(notes)
+        .where(where)
+        .orderBy(asc(notes.createdAt), asc(notes.id))
+        .limit(limit)
+        .offset(offset),
+      this.db.select({ total: count() }).from(notes).where(where),
+    ]);
+    return { items: rows.map((r) => this.toEntity(r)), total, limit, offset };
+  }
+
+  async findUser(id: string): Promise<User | undefined> {
+    const [row] = await this.db
+      .select()
+      .from(users)
+      .where(eq(users.id, id))
+      .limit(1);
+    return row;
+  }
+
+  async findSharedUsers(noteId: string): Promise<User[]> {
+    const rows = await this.db
+      .select({ user: users })
+      .from(noteShares)
+      .innerJoin(users, eq(users.id, noteShares.userId))
+      .where(eq(noteShares.noteId, noteId))
+      .orderBy(asc(noteShares.createdAt), asc(users.id));
+    return rows.map((r) => r.user);
+  }
+
+  async share(noteId: string, userId: string): Promise<void> {
+    await this.db
+      .insert(noteShares)
+      .values({ noteId, userId })
+      .onConflictDoNothing();
+  }
+
+  async unshare(noteId: string, userId: string): Promise<boolean> {
+    const rows = await this.db
+      .delete(noteShares)
+      .where(and(eq(noteShares.noteId, noteId), eq(noteShares.userId, userId)))
+      .returning({ noteId: noteShares.noteId });
+    return rows.length > 0;
+  }
+}
