diff --git a/test/notes.e2e-spec.ts b/test/notes.e2e-spec.ts
new file mode 100644
index 0000000..c98a5b8
--- /dev/null
+++ b/test/notes.e2e-spec.ts
@@ -0,0 +1,268 @@
+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import type { App } from 'supertest/types.js';
+import { AppModule } from '../src/app.module.js';
+import { configureApp } from '../src/bootstrap/configure-app.js';
+import { NoteResponseSchema } from '../src/notes/note.schema.js';
+
+/** Through the real HTTP stack: routing, validation pipe, error filter. */
+describe('notes (e2e)', () => {
+  let app: INestApplication<App>;
+  const base = '/api/v1/notes';
+  const missing = '00000000-0000-4000-8000-000000000000';
+
+  let n = 0;
+  let ownerId: string;
+  const valid = () => ({ ownerId, title: `Note ${++n}` });
+  /** A fresh user through the users API (the owner of every note here). */
+  const newUser = async () =>
+    (
+      await http
+        .post('/api/v1/users')
+        .send({ email: `notes-e2e-${++n}@example.com`, name: 'User' })
+        .expect(201)
+    ).body.id as string;
+
+  /** Shorthand for requests through the real HTTP server. */
+  const http = {
+    get: (url: string) => request(app.getHttpServer()).get(url),
+    post: (url: string) => request(app.getHttpServer()).post(url),
+    patch: (url: string) => request(app.getHttpServer()).patch(url),
+    put: (url: string) => request(app.getHttpServer()).put(url),
+    delete: (url: string) => request(app.getHttpServer()).delete(url),
+  };
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+    app = moduleRef.createNestApplication();
+    configureApp(app);
+    await app.init();
+    ownerId = await newUser();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('POST creates (201) and GET reads it back (200)', async () => {
+    const created = await http.post(base).send(valid()).expect(201);
+    await http
+      .get(`${base}/${created.body.id}`)
+      .expect(200)
+      .expect((res) => expect(res.body).toEqual(created.body));
+  });
+
+  it('responses carry only public fields (no private field ever leaves)', async () => {
+    const publicKeys = new Set(Object.keys(NoteResponseSchema.shape));
+    const leaked = (body: object) =>
+      Object.keys(body).filter((key) => !publicKeys.has(key));
+    const created = await http.post(base).send(valid()).expect(201);
+    expect(leaked(created.body)).toEqual([]);
+    const list = await http.get(base).expect(200);
+    expect(list.body.items.length).toBeGreaterThan(0);
+    for (const item of list.body.items) expect(leaked(item)).toEqual([]);
+  });
+
+  it('POST stores the PARSED body: unknown keys are stripped', async () => {
+    // Guards the validation pipe's contract over HTTP. A pipe that validated but
+    // passed the raw input through would store this key; unit tests cannot see it.
+    const created = await http
+      .post(base)
+      .send({ ...valid(), notAField: 'x' })
+      .expect(201);
+    expect(created.body).not.toHaveProperty('notAField');
+  });
+
+  it('POST rejects an invalid body (400)', () =>
+    http.post(base).send({ unexpected: 'shape' }).expect(400));
+
+  it('GET unknown id is 404 with the DomainError body', () =>
+    http
+      .get(`${base}/${missing}`)
+      .expect(404)
+      .expect((res) => expect(res.body.code).toBe('NOT_FOUND')));
+
+  it('GET a non-uuid id is 400', () =>
+    http.get(`${base}/not-a-uuid`).expect(400));
+
+  it('PATCH with an empty body is 400', async () => {
+    const created = await http.post(base).send(valid()).expect(201);
+    await http.patch(`${base}/${created.body.id}`).send({}).expect(400);
+  });
+
+  it('DELETE is 204, then GET is 404', async () => {
+    const created = await http.post(base).send(valid()).expect(201);
+    await http.delete(`${base}/${created.body.id}`).expect(204);
+    await http.get(`${base}/${created.body.id}`).expect(404);
+  });
+
+  it('POST applies the defaults and trims the title', async () => {
+    const created = await http
+      .post(base)
+      .send({ ownerId, title: '  Trimmed  ' })
+      .expect(201);
+    expect(created.body).toMatchObject({
+      ownerId,
+      title: 'Trimmed',
+      body: '',
+      status: 'open',
+      dueAt: null,
+    });
+  });
+
+  it.each([
+    ['a blank title', { title: '   ' }],
+    ['a title over 200 chars', { title: 'a'.repeat(201) }],
+    ['a body over 10,000 chars', { body: 'a'.repeat(10_001) }],
+    ['an unknown status', { status: 'archived' }],
+    ['a non-uuid ownerId', { ownerId: 'nope' }],
+    ['R3: a dueAt that is not a datetime', { dueAt: 'next tuesday' }],
+    ['R3: a dueAt with no offset', { dueAt: '2026-11-01T09:00:00' }],
+    ['R3: an impossible dueAt', { dueAt: '2026-02-31T09:00:00Z' }],
+  ])('POST rejects %s (400)', async (_label, extra) => {
+    await http
+      .post(base)
+      .send({ ...valid(), ...extra })
+      .expect(400);
+  });
+
+  it('R3: dueAt with an offset is stored and returned as UTC toISOString()', async () => {
+    const created = await http
+      .post(base)
+      .send({ ...valid(), dueAt: '2026-11-01T09:00:00+08:00' })
+      .expect(201);
+    expect(created.body.dueAt).toBe('2026-11-01T01:00:00.000Z');
+    const patched = await http
+      .patch(`${base}/${created.body.id}`)
+      .send({ dueAt: '2026-11-02T00:00:00-05:00' })
+      .expect(200);
+    expect(patched.body.dueAt).toBe('2026-11-02T05:00:00.000Z');
+    const cleared = await http
+      .patch(`${base}/${created.body.id}`)
+      .send({ dueAt: null })
+      .expect(200);
+    expect(cleared.body.dueAt).toBeNull();
+  });
+
+  it('R1: an owner that does not exist is 422', () =>
+    http
+      .post(base)
+      .send({ ...valid(), ownerId: missing })
+      .expect(422)
+      .expect((res) => expect(res.body.code).toBe('RULE_VIOLATION')));
+
+  it('PATCH ignores ownerId and keeps the other fields', async () => {
+    const other = await newUser();
+    const created = await http
+      .post(base)
+      .send({ ...valid(), body: 'keep me' })
+      .expect(201);
+    const res = await http
+      .patch(`${base}/${created.body.id}`)
+      .send({ ownerId: other, title: 'Still mine' })
+      .expect(200);
+    expect(res.body).toMatchObject({ ownerId, body: 'keep me' });
+  });
+
+  it('R2: a done note can only be reopened (422 otherwise)', async () => {
+    const created = await http
+      .post(base)
+      .send({ ...valid(), status: 'done' })
+      .expect(201);
+    const url = `${base}/${created.body.id}`;
+    await http
+      .patch(url)
+      .send({ title: 'Changed' })
+      .expect(422)
+      .expect((res) => expect(res.body.code).toBe('RULE_VIOLATION'));
+    await http.patch(url).send({ status: 'open' }).expect(200);
+    await http.patch(url).send({ title: 'Changed' }).expect(200);
+  });
+
+  it('GET filters by ownerId, status and sharedWith (AND); bad filters are 400', async () => {
+    const owner = await newUser();
+    const friend = await newUser();
+    const open = await http.post(base).send({ ownerId: owner, title: 'o' });
+    const done = await http
+      .post(base)
+      .send({ ownerId: owner, title: 'd', status: 'done' });
+    await http.put(`${base}/${done.body.id}/shares/${friend}`).expect(204);
+    const ids = async (query: object) =>
+      (await http.get(base).query(query).expect(200)).body.items.map(
+        (x: { id: string }) => x.id,
+      );
+    expect(await ids({ ownerId: owner })).toEqual([open.body.id, done.body.id]);
+    expect(await ids({ ownerId: owner, status: 'done' })).toEqual([
+      done.body.id,
+    ]);
+    expect(await ids({ sharedWith: friend })).toEqual([done.body.id]);
+    expect(await ids({ sharedWith: friend, status: 'open' })).toEqual([]);
+    await http.get(base).query({ ownerId: 'nope' }).expect(400);
+    await http.get(base).query({ status: 'archived' }).expect(400);
+  });
+
+  describe('sharing', () => {
+    it('PUT is 204 and idempotent; GET lists the users without private fields', async () => {
+      const friend = await newUser();
+      const note = await http.post(base).send(valid()).expect(201);
+      const url = `${base}/${note.body.id}/shares`;
+      await http.put(`${url}/${friend}`).expect(204);
+      await http.put(`${url}/${friend}`).expect(204);
+      const res = await http.get(url).expect(200);
+      expect(res.body.items.map((u: { id: string }) => u.id)).toEqual([friend]);
+      expect(Object.keys(res.body.items[0]).sort()).toEqual(
+        ['createdAt', 'email', 'id', 'name', 'updatedAt'].sort(),
+      );
+    });
+
+    it('R4: sharing with the owner is 422', async () => {
+      const note = await http.post(base).send(valid()).expect(201);
+      await http
+        .put(`${base}/${note.body.id}/shares/${ownerId}`)
+        .expect(422)
+        .expect((res) => expect(res.body.code).toBe('RULE_VIOLATION'));
+    });
+
+    it('unknown note or user is 404; non-uuid ids are 400', async () => {
+      const note = await http.post(base).send(valid()).expect(201);
+      await http.put(`${base}/${note.body.id}/shares/${missing}`).expect(404);
+      await http.put(`${base}/${missing}/shares/${ownerId}`).expect(404);
+      await http.get(`${base}/${missing}/shares`).expect(404);
+      await http.put(`${base}/${note.body.id}/shares/nope`).expect(400);
+    });
+
+    it('DELETE unshares (204), then 404', async () => {
+      const friend = await newUser();
+      const note = await http.post(base).send(valid()).expect(201);
+      const url = `${base}/${note.body.id}/shares/${friend}`;
+      await http.put(url).expect(204);
+      await http.delete(url).expect(204);
+      await http.delete(url).expect(404);
+    });
+
+    it('deleting the friend removes the share and keeps the note', async () => {
+      const friend = await newUser();
+      const note = await http.post(base).send(valid()).expect(201);
+      await http.put(`${base}/${note.body.id}/shares/${friend}`).expect(204);
+      await http.delete(`/api/v1/users/${friend}`).expect(204);
+      const res = await http.get(`${base}/${note.body.id}/shares`).expect(200);
+      expect(res.body.items).toEqual([]);
+      await http.get(`${base}/${note.body.id}`).expect(200);
+    });
+
+    it('deleting the note removes its shares (the friend can then be deleted)', async () => {
+      const friend = await newUser();
+      const note = await http.post(base).send(valid()).expect(201);
+      await http.put(`${base}/${note.body.id}/shares/${friend}`).expect(204);
+      await http.delete(`${base}/${note.body.id}`).expect(204);
+      await http.get(`${base}/${note.body.id}/shares`).expect(404);
+      expect(
+        (await http.get(base).query({ sharedWith: friend }).expect(200)).body
+          .items,
+      ).toEqual([]);
+    });
+  });
+});
diff --git a/test/users.e2e-spec.ts b/test/users.e2e-spec.ts
new file mode 100644
index 0000000..c8ae670
--- /dev/null
+++ b/test/users.e2e-spec.ts
@@ -0,0 +1,145 @@
+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import request from 'supertest';
+import type { App } from 'supertest/types.js';
+import { AppModule } from '../src/app.module.js';
+import { configureApp } from '../src/bootstrap/configure-app.js';
+import { DB, type Db } from '../src/database/database.types.js';
+import { notes } from '../src/notes/notes.table.js';
+import { UserResponseSchema } from '../src/users/user.schema.js';
+
+/** Through the real HTTP stack: routing, validation pipe, error filter. */
+describe('users (e2e)', () => {
+  let app: INestApplication<App>;
+  const base = '/api/v1/users';
+  const missing = '00000000-0000-4000-8000-000000000000';
+
+  let n = 0;
+  const valid = () => ({ email: `user-${++n}@example.com`, name: 'Ada' });
+
+  /** Shorthand for requests through the real HTTP server. */
+  const http = {
+    get: (url: string) => request(app.getHttpServer()).get(url),
+    post: (url: string) => request(app.getHttpServer()).post(url),
+    patch: (url: string) => request(app.getHttpServer()).patch(url),
+    delete: (url: string) => request(app.getHttpServer()).delete(url),
+  };
+
+  beforeAll(async () => {
+    const moduleRef = await Test.createTestingModule({
+      imports: [AppModule],
+    }).compile();
+    app = moduleRef.createNestApplication();
+    configureApp(app);
+    await app.init();
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  it('POST creates (201) and GET reads it back (200)', async () => {
+    const created = await http.post(base).send(valid()).expect(201);
+    await http
+      .get(`${base}/${created.body.id}`)
+      .expect(200)
+      .expect((res) => expect(res.body).toEqual(created.body));
+  });
+
+  it('responses carry only public fields (no private field ever leaves)', async () => {
+    const publicKeys = new Set(Object.keys(UserResponseSchema.shape));
+    const leaked = (body: object) =>
+      Object.keys(body).filter((key) => !publicKeys.has(key));
+    const created = await http.post(base).send(valid()).expect(201);
+    expect(leaked(created.body)).toEqual([]);
+    const list = await http.get(base).expect(200);
+    expect(list.body.items.length).toBeGreaterThan(0);
+    for (const item of list.body.items) expect(leaked(item)).toEqual([]);
+  });
+
+  it('POST stores the PARSED body: unknown keys are stripped', async () => {
+    // Guards the validation pipe's contract over HTTP. A pipe that validated but
+    // passed the raw input through would store this key; unit tests cannot see it.
+    const created = await http
+      .post(base)
+      .send({ ...valid(), notAField: 'x' })
+      .expect(201);
+    expect(created.body).not.toHaveProperty('notAField');
+  });
+
+  it('POST rejects an invalid body (400)', () =>
+    http.post(base).send({ unexpected: 'shape' }).expect(400));
+
+  it('GET unknown id is 404 with the DomainError body', () =>
+    http
+      .get(`${base}/${missing}`)
+      .expect(404)
+      .expect((res) => expect(res.body.code).toBe('NOT_FOUND')));
+
+  it('GET a non-uuid id is 400', () =>
+    http.get(`${base}/not-a-uuid`).expect(400));
+
+  it('PATCH with an empty body is 400', async () => {
+    const created = await http.post(base).send(valid()).expect(201);
+    await http.patch(`${base}/${created.body.id}`).send({}).expect(400);
+  });
+
+  it('DELETE is 204, then GET is 404', async () => {
+    const created = await http.post(base).send(valid()).expect(201);
+    await http.delete(`${base}/${created.body.id}`).expect(204);
+    await http.get(`${base}/${created.body.id}`).expect(404);
+  });
+
+  it('POST lower-cases the email and trims the name', async () => {
+    const created = await http
+      .post(base)
+      .send({ email: `Mixed-${++n}@Example.COM`, name: '  Ada  ' })
+      .expect(201);
+    expect(created.body.email).toBe(`mixed-${n}@example.com`);
+    expect(created.body.name).toBe('Ada');
+  });
+
+  it.each([
+    ['an invalid email', { email: 'not-an-email', name: 'Ada' }],
+    [
+      'an email over 254 chars',
+      { email: `${'a'.repeat(250)}@example.com`, name: 'A' },
+    ],
+    ['a blank name', { email: 'blank@example.com', name: '   ' }],
+    [
+      'a name over 100 chars',
+      { email: 'long@example.com', name: 'a'.repeat(101) },
+    ],
+  ])('POST rejects %s (400)', async (_label, body) => {
+    await http.post(base).send(body).expect(400);
+  });
+
+  it('R1: the same email in another case is 409', async () => {
+    const created = await http.post(base).send(valid()).expect(201);
+    await http
+      .post(base)
+      .send({ email: created.body.email.toUpperCase(), name: 'Twin' })
+      .expect(409)
+      .expect((res) => expect(res.body.code).toBe('CONFLICT'));
+  });
+
+  it('R1: PATCH onto a taken email (any case) is 409', async () => {
+    const a = await http.post(base).send(valid()).expect(201);
+    const b = await http.post(base).send(valid()).expect(201);
+    await http
+      .patch(`${base}/${b.body.id}`)
+      .send({ email: a.body.email.toUpperCase() })
+      .expect(409);
+  });
+
+  it('R2: a user who owns notes cannot be deleted (409)', async () => {
+    const owner = await http.post(base).send(valid()).expect(201);
+    const db = app.get<Db>(DB);
+    await db.insert(notes).values({ ownerId: owner.body.id, title: 'Mine' });
+    await http
+      .delete(`${base}/${owner.body.id}`)
+      .expect(409)
+      .expect((res) => expect(res.body.code).toBe('CONFLICT'));
+    await http.get(`${base}/${owner.body.id}`).expect(200);
+  });
+});
