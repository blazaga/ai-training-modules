+import { ConflictError, NotFoundError } from '../common/errors/domain-error.js';
+import { notes } from '../notes/notes.table.js';
+import { connectInMemory, type Connection } from '../database/connect.js';
+import { DrizzleUsersRepository } from './users.drizzle-repository.js';
+import { UsersService } from './users.service.js';
+import { users } from './users.table.js';
+
+/**
+ * Unit tests against a REAL database (SQLite in memory, migrated): the
+ * repository's SQL is exercised, not mocked. One database per file.
+ */
+describe('UsersService', () => {
+  let connection: Connection;
+  let service: UsersService;
+
+  const valid = { email: 'ada@example.com', name: 'Ada' };
+
+  beforeAll(async () => {
+    connection = await connectInMemory();
+  });
+
+  afterAll(async () => {
+    await connection.close();
+  });
+
+  beforeEach(async () => {
+    await connection.db.delete(notes);
+    await connection.db.delete(users);
+    service = new UsersService(new DrizzleUsersRepository(connection.db));
+  });
+
+  it('creates and reads back one user', async () => {
+    const created = await service.create(valid);
+    await expect(service.findOne(created.id)).resolves.toEqual(created);
+  });
+
+  it('throws NotFoundError for an unknown id', async () => {
+    await expect(
+      service.findOne('00000000-0000-4000-8000-000000000000'),
+    ).rejects.toBeInstanceOf(NotFoundError);
+  });
+
+  it('removes one user', async () => {
+    const created = await service.create(valid);
+    await service.remove(created.id);
+    await expect(service.findOne(created.id)).rejects.toBeInstanceOf(
+      NotFoundError,
+    );
+  });
+
+  describe('R1: email is unique', () => {
+    it('allows a different email', async () => {
+      await service.create(valid);
+      await expect(
+        service.create({ ...valid, email: 'grace@example.com' }),
+      ).resolves.toMatchObject({ email: 'grace@example.com' });
+    });
+
+    it('refuses a taken email on create with ConflictError', async () => {
+      await service.create(valid);
+      await expect(service.create(valid)).rejects.toBeInstanceOf(ConflictError);
+    });
+
+    it('refuses renaming onto a taken email with ConflictError', async () => {
+      await service.create(valid);
+      const other = await service.create({
+        ...valid,
+        email: 'grace@example.com',
+      });
+      await expect(
+        service.update(other.id, { email: valid.email }),
+      ).rejects.toBeInstanceOf(ConflictError);
+    });
+  });
+
+  describe('R2: a user who owns notes cannot be deleted', () => {
+    it('refuses with ConflictError and keeps the user', async () => {
+      const owner = await service.create(valid);
+      await connection.db
+        .insert(notes)
+        .values({ ownerId: owner.id, title: 'Mine' });
+      await expect(service.remove(owner.id)).rejects.toBeInstanceOf(
+        ConflictError,
+      );
+      await expect(service.findOne(owner.id)).resolves.toEqual(owner);
+    });
+
+    it('allows deleting a user who owns none', async () => {
+      const free = await service.create(valid);
+      await expect(service.remove(free.id)).resolves.toBeUndefined();
+    });
+  });
+});
diff --git a/src/users/users.service.ts b/src/users/users.service.ts
new file mode 100644
index 0000000..429c14d
--- /dev/null
+++ b/src/users/users.service.ts
@@ -0,0 +1,62 @@
+import { Inject, Injectable } from '@nestjs/common';
+import { NotFoundError } from '../common/errors/domain-error.js';
+import type { Entity, Page } from '../common/persistence/repository.js';
+import { USERS_REPOSITORY, type UsersRepository } from './users.repository.js';
+import type { CreateUserDto } from './dto/create-user.dto.js';
+import type { UpdateUserDto } from './dto/update-user.dto.js';
+import type { User } from './entities/user.entity.js';
+
+/**
+ * Business logic for users. Shape rules (types, lengths, enums) live in the
+ * schema. Only rules that need state or more than one field belong here, and
+ * they fail by throwing a DomainError, never by returning a flag.
+ */
+@Injectable()
+export class UsersService {
+  constructor(
+    @Inject(USERS_REPOSITORY) private readonly repo: UsersRepository,
+  ) {}
+
+  async create(input: CreateUserDto): Promise<User> {
+    // No create-time rules here. R1 (unique email): the schema lower-cases it and the
+    // table's unique index refuses a duplicate, which the adapter throws as ConflictError.
+    return this.repo.create(await this.toStored(input));
+  }
+
+  /** The create payload in its STORED shape: write-only inputs become private fields. */
+  private toStored(
+    input: CreateUserDto,
+  ): Promise<Omit<User, keyof Entity>> | Omit<User, keyof Entity> {
+    // No write-only inputs.
+    return input;
+  }
+
+  findPage(limit: number, offset: number): Promise<Page<User>> {
+    return this.repo.findPage(limit, offset);
+  }
+
+  async findOne(id: string): Promise<User> {
+    const found = await this.repo.findById(id);
+    if (!found) throw new NotFoundError('User', id);
+    return found;
+  }
+
+  async update(id: string, patch: UpdateUserDto): Promise<User> {
+    const current = await this.findOne(id);
+    // No update-time rules (a rename onto a taken email is R1, refused by the index).
+    void current;
+    const updated = await this.repo.update(id, patch);
+    if (!updated) throw new NotFoundError('User', id);
+    return updated;
+  }
+
+  async remove(id: string): Promise<void> {
+    const current = await this.findOne(id);
+    // No remove-time rules here. R2 (a user who owns notes cannot be deleted) is the
+    // notes.owner_id foreign key (RESTRICT); the adapter throws it as ConflictError.
+    // Shares WITH this user cascade away.
+    void current;
+    const deleted = await this.repo.delete(id);
+    if (!deleted) throw new NotFoundError('User', id);
+  }
+}
