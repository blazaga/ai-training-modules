+import { Module } from '@nestjs/common';
+import { NotesController } from './notes.controller.js';
+import { DrizzleNotesRepository } from './notes.drizzle-repository.js';
+import { NOTES_REPOSITORY } from './notes.repository.js';
+import { NotesService } from './notes.service.js';
+
+@Module({
+  controllers: [NotesController],
+  providers: [
+    NotesService,
+    // SQLite via drizzle (DB is provided globally by DatabaseModule).
+    { provide: NOTES_REPOSITORY, useClass: DrizzleNotesRepository },
+  ],
+  exports: [NotesService],
+})
+export class NotesModule {}
