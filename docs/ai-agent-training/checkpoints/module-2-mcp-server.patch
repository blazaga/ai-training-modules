@@ -0,0 +1,37 @@
+import { sqlShape } from './sql-statement.js';
+
+describe('sqlShape', () => {
+  it('counts statements, ignoring a trailing ; and ; inside literals or comments', () => {
+    expect(sqlShape('select 1;').statements).toBe(1);
+    expect(sqlShape('select \'a;b\', "c;d" -- e;f\n').statements).toBe(1);
+    expect(sqlShape('select 1 /* ; */').statements).toBe(1);
+    expect(sqlShape('select 1; delete from notes').statements).toBe(2);
+    expect(sqlShape("select 'it''s'; delete from notes").statements).toBe(2);
+  });
+
+  it('reads the first keyword after comments, lower-cased', () => {
+    expect(sqlShape('  -- hi\n/* x */ SELECT 1').keyword).toBe('select');
+    expect(sqlShape('With x as (select 1) delete from notes').keyword).toBe(
+      'with',
+    );
+    expect(sqlShape('').keyword).toBe('');
+  });
+
+  it('finds only a top-level WHERE, not one in a literal or a subquery', () => {
+    expect(sqlShape("delete from notes where id = 'x'").hasTopLevelWhere).toBe(
+      true,
+    );
+    expect(sqlShape("update notes set title = 'where'").hasTopLevelWhere).toBe(
+      false,
+    );
+    expect(
+      sqlShape(
+        "update notes set title = (select name from users where id = 'x')",
+      ).hasTopLevelWhere,
+    ).toBe(false);
+    expect(
+      sqlShape('delete from notes where id in (select note_id from x)')
+        .hasTopLevelWhere,
+    ).toBe(true);
+  });
+});
diff --git a/src/mcp/sql-statement.ts b/src/mcp/sql-statement.ts
new file mode 100644
index 0000000..3b5d256
--- /dev/null
+++ b/src/mcp/sql-statement.ts
@@ -0,0 +1,77 @@
+/**
+ * A light look at one SQL string, for the MCP `query` and `execute` tools: how many statements
+ * it holds, its first keyword, and whether it has a top-level WHERE.
+ *
+ * String literals, quoted identifiers and comments are blanked first, so a `;` or a `where`
+ * inside `'…'` does not count. This is a FIRST gate only. It cannot see what a statement does
+ * (a `WITH … DELETE` starts with WITH), so `query` also runs under `PRAGMA query_only` in a
+ * transaction that is always rolled back (src/mcp/notes-db.server.ts).
+ *
+ * Why a statement count at all: libSQL's `execute` runs only the FIRST statement of
+ * `select 1; delete from notes` and silently drops the rest (measured, @libsql/client 0.18),
+ * so a second statement would be neither refused nor run.
+ */
+export interface SqlShape {
+  /** Non-empty statements, separated by top-level `;`. */
+  statements: number;
+  /** The first keyword, lower-cased (`select`, `with`, `insert`…), or '' for none. */
+  keyword: string;
+  /** A WHERE outside any parentheses, i.e. not only inside a subquery. */
+  hasTopLevelWhere: boolean;
+}
+
+/** SQLite's quote characters and what closes each: strings, identifiers (three spellings). */
+const CLOSING_QUOTE: Record<string, string> = {
+  "'": "'",
+  '"': '"',
+  '`': '`',
+  '[': ']',
+};
+
+/** Literal and comment contents replaced by spaces; everything else kept. */
+function blankLiteralsAndComments(sql: string): string {
+  let out = '';
+  let i = 0;
+  while (i < sql.length) {
+    const c = sql[i];
+    const close = CLOSING_QUOTE[c] ?? '';
+    if (close) {
+      // A doubled quote inside a literal ('it''s') is an escaped quote, not the end.
+      let j = i + 1;
+      while (j < sql.length) {
+        if (sql[j] === close && !(close !== ']' && sql[j + 1] === close)) break;
+        j += sql[j] === close ? 2 : 1;
+      }
+      out += ' ';
+      i = j + 1;
+    } else if (c === '-' && sql[i + 1] === '-') {
+      const end = sql.indexOf('\n', i);
+      out += ' ';
+      i = end === -1 ? sql.length : end;
+    } else if (c === '/' && sql[i + 1] === '*') {
+      const end = sql.indexOf('*/', i + 2);
+      out += ' ';
+      i = end === -1 ? sql.length : end + 2;
+    } else {
+      out += c;
+      i += 1;
+    }
+  }
+  return out;
+}
+
+export function sqlShape(sql: string): SqlShape {
+  const code = blankLiteralsAndComments(sql);
+  const parts = code.split(';').filter((s) => s.trim() !== '');
+  const first = parts[0] ?? '';
+  let topLevel = first;
+  for (let prev = ''; prev !== topLevel;) {
+    prev = topLevel;
+    topLevel = topLevel.replace(/\([^()]*\)/g, ' ');
+  }
+  return {
+    statements: parts.length,
+    keyword: (/^\s*([a-z]+)/i.exec(first)?.[1] ?? '').toLowerCase(),
+    hasTopLevelWhere: /\bwhere\b/i.test(topLevel),
+  };
+}
diff --git a/test/mcp-server.e2e-spec.ts b/test/mcp-server.e2e-spec.ts
new file mode 100644
index 0000000..6d0595c
--- /dev/null
+++ b/test/mcp-server.e2e-spec.ts
@@ -0,0 +1,239 @@
+import { createClient, type Client as SqlClient } from '@libsql/client';
+import { Client } from '@modelcontextprotocol/client';
+import { StdioClientTransport } from '@modelcontextprotocol/client/stdio';
+import { spawn, spawnSync } from 'node:child_process';
+import { copyFileSync, mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+/**
+ * specs/mcp.md: the BUILT stdio server (dist/, built by global-setup) on a COPY of the seeded
+ * data/app.db, never the file itself. `db` reads the copy to check what a tool really did.
+ */
+describe('MCP server (e2e, stdio)', () => {
+  const root = join(import.meta.dirname, '..');
+  const entry = join(root, 'dist', 'mcp-server.js');
+  const NIL = '00000000-0000-4000-8000-000000000000';
+  let dir: string;
+  let file: string;
+  let client: Client;
+  let db: SqlClient;
+
+  type Result = { isError?: boolean; content: { text?: string }[] };
+  const call = async (name: string, args: Record<string, unknown> = {}) => {
+    const r = (await client.callTool({ name, arguments: args })) as Result;
+    return { isError: r.isError === true, text: r.content[0]?.text ?? '' };
+  };
+  const ok = async <T>(name: string, args: Record<string, unknown> = {}) => {
+    const r = await call(name, args);
+    if (r.isError) throw new Error(`${name}: ${r.text}`);
+    return JSON.parse(r.text) as T;
+  };
+  /** The first column of the first row, as text (ids, counts). */
+  const one = async (sql: string, args: string[] = []) => {
+    const value = (await db.execute({ sql, args })).rows[0]?.[0];
+    return typeof value === 'string' ? value : String(Number(value));
+  };
+  const count = async (from: string) =>
+    Number(await one(`select count(*) from ${from}`));
+
+  beforeAll(async () => {
+    dir = mkdtempSync(join(tmpdir(), 'mcp-e2e-'));
+    file = join(dir, 'app.db');
+    copyFileSync(join(root, 'data', 'app.db'), file);
+    db = createClient({ url: `file:${file}` });
+    client = new Client({ name: 'e2e', version: '1.0.0' });
+    await client.connect(
+      new StdioClientTransport({
+        command: process.execPath,
+        args: [entry],
+        env: { DATABASE_URL: `file:${file}` },
+        stderr: 'ignore',
+      }),
+    );
+  });
+
+  afterAll(async () => {
+    await client?.close();
+    db?.close();
+    rmSync(dir, { recursive: true, force: true });
+  });
+
+  it('writes only JSON-RPC to stdout and identifies as notes-db 0.1.0', async () => {
+    const child = spawn(process.execPath, [entry], {
+      env: { DATABASE_URL: `file:${file}` },
+    });
+    let stdout = '';
+    let stderr = '';
