+        },
+      }) + '\n',
+    );
+    await vi.waitFor(() => expect(stdout).toContain('\n'), { timeout: 10_000 });
+    child.stdin.end();
+    await new Promise((r) => child.once('exit', r));
+    const lines = stdout.split('\n').filter(Boolean);
