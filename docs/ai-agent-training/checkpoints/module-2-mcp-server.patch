+// `npm run mcp`: the MCP server of specs/mcp.md over stdio, on the SQLite database. Not a Nest
+// app. STDOUT BELONGS TO THE PROTOCOL: every diagnostic goes to stderr (console.error).
+import 'reflect-metadata';
+import { StdioServerTransport } from '@modelcontextprotocol/server/stdio';
+import { existsSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { validateEnv } from './config/env.schema.js';
+import { connectSqlite } from './database/connect.js';
+import { createNotesDbServer } from './mcp/notes-db.server.js';
+
+const DEFAULT_DATABASE_URL = 'file:./data/app.db';
+
+function fail(message: string): never {
+  console.error(`mcp-server: ${message}`);
+  process.exit(1);
+}
+
+let url: string;
+try {
+  url = validateEnv(process.env).DATABASE_URL ?? DEFAULT_DATABASE_URL;
+} catch (error) {
+  fail((error as Error).message);
+}
+
+// connectSqlite would CREATE a missing file, and serve an empty database with no tables. That
+// is what a client started from the wrong folder gets, so refuse instead. (The path is not a
+// secret; no other config value is printed.)
+const file = resolve(url.slice('file:'.length));
+if (!existsSync(file)) {
+  fail(
+    `database file not found: ${file}. Set DATABASE_URL to an absolute file: URL, ` +
+      'or start the server from the project folder.',
+  );
+}
+
+// connectSqlite turns PRAGMA foreign_keys on.
+const connection = await connectSqlite(url);
+const server = createNotesDbServer(connection.db);
+await server.connect(new StdioServerTransport());
+console.error(`mcp-server: ready (${file})`);
diff --git a/src/mcp/notes-db.server.ts b/src/mcp/notes-db.server.ts
new file mode 100644
index 0000000..2165928
--- /dev/null
+++ b/src/mcp/notes-db.server.ts
@@ -0,0 +1,355 @@
+import type { Client } from '@libsql/client';
+import { McpServer } from '@modelcontextprotocol/server';
+import { and, asc, count, eq, type SQL } from 'drizzle-orm';
+import { z } from 'zod';
+import { DomainError } from '../common/errors/domain-error.js';
+import type { Db } from '../database/database.types.js';
+import { noteShares } from '../notes/note-shares.table.js';
+import { CreateNoteSchema, UpdateNoteSchema } from '../notes/note.schema.js';
+import { DrizzleNotesRepository } from '../notes/notes.drizzle-repository.js';
+import { NotesService } from '../notes/notes.service.js';
+import { notes } from '../notes/notes.table.js';
+import { CreateUserSchema } from '../users/user.schema.js';
+import { DrizzleUsersRepository } from '../users/users.drizzle-repository.js';
+import { UsersService } from '../users/users.service.js';
+import { users } from '../users/users.table.js';
+import { sqlShape } from './sql-statement.js';
+
+/** specs/mcp.md: every result is one text block holding JSON. */
+const json = (value: unknown) => ({
+  content: [{ type: 'text' as const, text: JSON.stringify(value) }],
+});
+
+type ToolCode =
+  DomainError['code'] | 'READ_ONLY' | 'NOT_ALLOWED' | 'CONSTRAINT';
+
+/** A tool error the model can read: `isError` and `"<CODE>: <message>"`. */
+const toolError = (code: ToolCode, message: string) => ({
+  isError: true,
+  content: [{ type: 'text' as const, text: `${code}: ${message}` }],
+});
+
+/**
+ * Runs a typed write through the module 1 services, so the REST rules hold here too, and turns
+ * their DomainErrors into tool errors. Anything else is a bug and is rethrown for the SDK.
+ */
+async function viaService(run: () => Promise<unknown>) {
+  try {
+    return json(await run());
+  } catch (error) {
+    if (error instanceof DomainError) {
+      return toolError(error.code, error.message);
+    }
+    throw error;
+  }
+}
+
+/** The libSQL driver code (`SQLITE_READONLY`, `SQLITE_CONSTRAINT_…`) of an error, if any. */
+const sqliteCode = (error: unknown): string => {
+  const code = (error as { extendedCode?: unknown } | undefined)?.extendedCode;
+  return typeof code === 'string' ? code : '';
+};
+
+const TABLES = { users, notes, note_shares: noteShares } as const;
+const TableName = z.enum(['users', 'notes', 'note_shares']);
+
+const READ = { readOnlyHint: true } as const;
+const WRITE = { readOnlyHint: false, destructiveHint: false } as const;
+const DESTRUCTIVE = { readOnlyHint: false, destructiveHint: true } as const;
+
+/** The MCP server of specs/mcp.md over one database. Transport-free, so a test can drive it. */
+export function createNotesDbServer(db: Db): McpServer {
+  const usersService = new UsersService(new DrizzleUsersRepository(db));
+  const notesService = new NotesService(new DrizzleNotesRepository(db));
+  // drizzle's libSQL database carries its client as `$client` (drizzle-orm 0.45); the Db
+  // type does not declare it. `query` and `execute` need the raw client for transactions and
+  // rowsAffected.
+  const client = (db as Db & { $client: Client }).$client;
+  const server = new McpServer({ name: 'notes-db', version: '0.1.0' });
+
+  // ---- read tools ---------------------------------------------------------------------------
+
+  server.registerTool(
+    'list-tables',
+    {
+      description:
+        'The tables of the notes database (users, notes, note_shares) with their row counts.',
+      annotations: READ,
+    },
+    async () =>
+      json(
+        await Promise.all(
+          Object.entries(TABLES).map(async ([table, t]) => {
+            const [{ rows }] = await db.select({ rows: count() }).from(t);
+            return { table, rows };
+          }),
+        ),
+      ),
+  );
+
+  server.registerTool(
+    'describe-table',
+    {
+      description:
+        'The columns of one table: name, SQL type, NOT NULL, primary key. Column names are snake_case.',
+      inputSchema: z.object({ table: TableName }),
+      annotations: READ,
+    },
+    async ({ table }) => {
+      // `table` is one of three fixed names (the enum above), never free text.
+      const rs = await client.execute(`PRAGMA table_info(${table})`);
+      return json(
+        rs.rows.map((c) => ({
+          name: c.name,
+          type: c.type,
+          notNull: c.notnull === 1,
+          primaryKey: Number(c.pk) > 0,
+        })),
+      );
+    },
+  );
+
+  server.registerTool(
+    'query',
+    {
+      description:
+        'Run ONE read-only SQL statement (SELECT, or WITH … SELECT) on the SQLite database and ' +
+        'get { rows, rowCount }, at most `limit` rows. Writes are refused (READ_ONLY); use the ' +
+        'write tools for changes. Tables: users, notes, note_shares; call describe-table for columns.',
+      inputSchema: z.object({
+        sql: z.string().min(1),
+        limit: z.number().int().min(1).max(200).default(50),
+      }),
+      annotations: READ,
+    },
+    async ({ sql, limit }) => {
+      const shape = sqlShape(sql);
+      if (
+        shape.statements !== 1 ||
+        !['select', 'with'].includes(shape.keyword)
+      ) {
+        return toolError(
+          'READ_ONLY',
+          'query runs exactly one SELECT (or WITH … SELECT) statement; use the write tools to change data',
+        );
+      }
+      // The string check cannot see a write hidden in a WITH, so SQLite refuses writes on
+      // this connection (query_only), and the transaction is rolled back whatever happens.
+      const tx = await client.transaction('deferred');
+      try {
+        await tx.execute('PRAGMA query_only = ON');
+        const rs = await tx.execute(sql);
+        const rows = rs.rows.slice(0, limit);
+        return json({ rows, rowCount: rows.length });
+      } catch (error) {
+        if (sqliteCode(error) === 'SQLITE_READONLY') {
+          return toolError(
+            'READ_ONLY',
+            'the statement tries to write; use the write tools to change data',
+          );
+        }
+        throw error;
+      } finally {
+        // The connection goes back to the pool: it must not stay read-only.
+        try {
+          await tx.execute('PRAGMA query_only = OFF');
+        } finally {
+          tx.close();
+        }
+      }
+    },
+  );
+
+  server.registerTool(
+    'notes-for-user',
+    {
+      description:
+        "A user's notes: the ones they own (access 'owner') and the ones shared with them " +
+        "(access 'shared'), optionally only open or done ones.",
+      inputSchema: z.object({
+        userId: z.string().uuid(),
+        include: z.enum(['owned', 'shared', 'all']).default('all'),
+        status: z.enum(['open', 'done']).optional(),
+      }),
+      annotations: READ,
+    },
+    ({ userId, include, status }) =>
+      viaService(async () => {
+        await usersService.findOne(userId);
+        const byStatus = status ? eq(notes.status, status) : undefined;
+        const order = [asc(notes.createdAt), asc(notes.id)];
+        const owned = (where: SQL | undefined) =>
+          db
+            .select()
+            .from(notes)
+            .where(where)
+            .orderBy(...order);
+        const result: object[] = [];
+        if (include !== 'shared') {
+          const rows = await owned(and(eq(notes.ownerId, userId), byStatus));
+          result.push(...rows.map((n) => ({ ...n, access: 'owner' })));
+        }
+        if (include !== 'owned') {
+          const rows = await db
+            .select({ note: notes })
+            .from(noteShares)
+            .innerJoin(notes, eq(notes.id, noteShares.noteId))
+            .where(and(eq(noteShares.userId, userId), byStatus))
+            .orderBy(...order);
+          result.push(...rows.map((r) => ({ ...r.note, access: 'shared' })));
+        }
+        return result;
+      }),
+  );
+
+  // ---- typed write tools: the module 1 services, so the REST rules apply --------------------
+
+  server.registerTool(
+    'create-user',
+    {
+      description:
+        'Create a user. The email is stored lower-cased and must not be taken (CONFLICT).',
+      inputSchema: CreateUserSchema,
+      annotations: WRITE,
+    },
+    (input) => viaService(() => usersService.create(input)),
+  );
+
+  server.registerTool(
+    'create-note',
+    {
+      description:
+        'Create an open note owned by an existing user. dueAt is an ISO-8601 date-time with an ' +
+        'offset (e.g. 2026-11-01T09:00:00+08:00) and is stored in UTC.',
+      inputSchema: CreateNoteSchema.omit({ status: true }),
+      annotations: WRITE,
+    },
+    (input) =>
+      viaService(() => notesService.create({ ...input, status: 'open' })),
+  );
+
+  server.registerTool(
+    'update-note',
+    {
+      description:
+        'Change a note: at least one of title, body, status, dueAt. A done note can only be ' +
+        "reopened ({ status: 'open' } alone); anything else on it is RULE_VIOLATION.",
+      inputSchema: z
+        .object({ id: z.string().uuid(), ...UpdateNoteSchema.shape })
+        // `id` plus at least one field.
+        .refine((input) => Object.keys(input).length > 1, {
+          message: 'Provide at least one of title, body, status, dueAt',
+        }),
+      annotations: WRITE,
+    },
+    ({ id, ...patch }) => viaService(() => notesService.update(id, patch)),
+  );
+
+  server.registerTool(
+    'delete-note',
+    {
+      description: 'Delete a note; its shares are deleted with it.',
+      inputSchema: z.object({ id: z.string().uuid() }),
+      annotations: DESTRUCTIVE,
+    },
+    ({ id }) =>
+      viaService(async () => {
+        await notesService.remove(id);
+        return { id, deleted: true };
+      }),
+  );
+
+  server.registerTool(
+    'share-note',
+    {
+      description:
+        'Share a note with another user (sharing twice is fine; never with its owner).',
+      inputSchema: z.object({
+        noteId: z.string().uuid(),
+        userId: z.string().uuid(),
+      }),
+      annotations: WRITE,
+    },
+    ({ noteId, userId }) =>
+      viaService(async () => {
+        await notesService.share(noteId, userId);
+        return { noteId, userId, shared: true };
+      }),
+  );
+
+  server.registerTool(
+    'unshare-note',
+    {
+      description:
+        'Stop sharing a note with a user (NOT_FOUND if it was not shared).',
+      inputSchema: z.object({
+        noteId: z.string().uuid(),
+        userId: z.string().uuid(),
+      }),
+      annotations: DESTRUCTIVE,
+    },
+    ({ noteId, userId }) =>
+      viaService(async () => {
+        await notesService.unshare(noteId, userId);
+        return { noteId, userId, shared: false };
+      }),
+  );
+
+  // ---- the SQL write path -------------------------------------------------------------------
+
+  server.registerTool(
+    'execute',
+    {
+      description:
+        'Run ONE INSERT, UPDATE or DELETE statement and get { rowsAffected }. UPDATE and DELETE ' +
+        'need a WHERE clause. Refused (NOT_ALLOWED, nothing runs): SELECT (use query), CREATE, ' +
+        'DROP, ALTER, PRAGMA, ATTACH and more than one statement. Foreign keys, NOT NULL and ' +
+        'unique constraints still hold (CONSTRAINT). The business rules are NOT checked here: a ' +
+        'done note can only be reopened, and a note is never shared with its owner. Prefer the ' +
+        'typed tools (create-user, create-note, update-note, delete-note, share-note, ' +
+        'unshare-note), which enforce them. A hand-written row needs: id a v4 UUID, every ' +
+        'timestamp (created_at, updated_at, due_at) an ISO-8601 UTC string like ' +
+        "2026-11-01T01:00:00.000Z, status 'open' or 'done', emails lower-case.",
+      inputSchema: z.object({ sql: z.string().min(1) }),
+      annotations: DESTRUCTIVE,
+    },
+    async ({ sql }) => {
+      const shape = sqlShape(sql);
+      if (shape.statements !== 1) {
+        return toolError('NOT_ALLOWED', 'exactly one statement per call');
+      }
+      if (!['insert', 'update', 'delete'].includes(shape.keyword)) {
+        return toolError(
+          'NOT_ALLOWED',
+          `only INSERT, UPDATE or DELETE; got ${shape.keyword.toUpperCase() || 'no statement'}` +
+            (shape.keyword === 'select' ? ' (use the query tool)' : ''),
+        );
+      }
+      if (shape.keyword !== 'insert' && !shape.hasTopLevelWhere) {
+        return toolError(
+          'NOT_ALLOWED',
+          `${shape.keyword.toUpperCase()} without a WHERE clause would change every row`,
+        );
+      }
+      try {
+        const rs = await client.execute(sql);
+        // With RETURNING, libSQL reports rowsAffected 0 (measured on 115 changed rows), so
+        // count the returned rows instead: one per affected row.
+        return json({
+          rowsAffected: rs.columns.length ? rs.rows.length : rs.rowsAffected,
+        });
+      } catch (error) {
+        const code = sqliteCode(error);
+        if (code.startsWith('SQLITE_CONSTRAINT')) {
+          return toolError(
+            'CONSTRAINT',
+            error instanceof Error ? error.message : code,
+          );
+        }
+        throw error;
+      }
+    },
+  );
+
+  return server;
+}
