@@ -0,0 +1,30 @@
+import { isSingleReadStatement } from './read-only-sql.js';
+
+describe('isSingleReadStatement', () => {
+  it.each([
+    'select id from notes',
+    'SELECT 1;',
+    '  with x as (select 1) select * from x  ',
+    "select ';' as semi, 'it''s; fine' from notes",
+    'select 1 -- trailing; comment',
+    'select /* ; */ 1',
+    'select "a;b" from notes',
+  ])('accepts %s', (sql) => {
+    expect(isSingleReadStatement(sql)).toBe(true);
+  });
+
+  it.each([
+    'delete from notes',
+    'update notes set title = 1',
+    'drop table note_shares',
+    'select 1; delete from notes',
+    'select 1; pragma query_only = 0',
+    'pragma table_info(notes)',
+    'insert into notes select * from notes',
+    '/* select */ delete from notes',
+    'selectx from notes',
+    '',
+  ])('refuses %s', (sql) => {
+    expect(isSingleReadStatement(sql)).toBe(false);
+  });
+});
diff --git a/src/mcp/read-only-sql.ts b/src/mcp/read-only-sql.ts
new file mode 100644
index 0000000..84c871d
--- /dev/null
+++ b/src/mcp/read-only-sql.ts
@@ -0,0 +1,51 @@
+/**
+ * The lexical half of the `query` tool's read-only guard (specs/mcp.md). It answers one
+ * question: is this text ONE statement that starts with SELECT or WITH?
+ *
+ * It is not the enforcement. `WITH x AS (…) DELETE …` starts with WITH and passes here; the
+ * write is refused by the connection the query runs on (`PRAGMA query_only = ON`, see
+ * mcp-server.ts), which SQLite applies to whatever the statement turns out to do.
+ *
+ * Why the single-statement check exists at all: libSQL's `execute()` runs only the FIRST
+ * statement of `select 1; delete from notes` and returns its rows without an error
+ * (measured, @libsql/client 0.18.0). Nothing is written, but the caller would believe the
+ * whole text ran, so it is refused instead.
+ */
+export function isSingleReadStatement(sql: string): boolean {
+  const code = stripLiteralsAndComments(sql).trim().replace(/;\s*$/, '');
+  if (code.includes(';')) return false;
+  return /^(select|with)\b/i.test(code);
+}
+
+/**
+ * The SQL with every string, quoted identifier and comment replaced by a space, so a `;`
+ * or a keyword inside one of them is not mistaken for code. An unterminated one swallows
+ * the rest of the text, which SQLite would reject anyway.
+ */
+function stripLiteralsAndComments(sql: string): string {
+  let out = '';
+  let i = 0;
+  while (i < sql.length) {
+    const c = sql[i];
+    const end = (close: string, from: number) => {
+      const at = sql.indexOf(close, from);
+      return at === -1 ? sql.length : at + close.length;
+    };
+    if (c === "'" || c === '"' || c === '`') {
+      // A doubled quote inside is an escaped quote: the scan simply resumes after it.
+      i = end(c, i + 1);
+    } else if (c === '[') {
+      i = end(']', i + 1);
+    } else if (c === '-' && sql[i + 1] === '-') {
+      i = end('\n', i + 2);
+    } else if (c === '/' && sql[i + 1] === '*') {
+      i = end('*/', i + 2);
+    } else {
+      out += c;
+      i += 1;
+      continue;
+    }
+    out += ' ';
+  }
+  return out;
+}
diff --git a/test/mcp-server.e2e-spec.ts b/test/mcp-server.e2e-spec.ts
new file mode 100644
index 0000000..4dfe3df
--- /dev/null
+++ b/test/mcp-server.e2e-spec.ts
@@ -0,0 +1,263 @@
+import { createClient, type Client as SqlClient } from '@libsql/client';
+import { LATEST_PROTOCOL_VERSION } from '@modelcontextprotocol/server';
+import { spawn, type ChildProcess } from 'node:child_process';
+import { copyFileSync, mkdtempSync, rmSync } from 'node:fs';
+import { join } from 'node:path';
+import { createInterface } from 'node:readline';
+
+/**
+ * specs/mcp.md over the wire: spawns the BUILT dist/mcp-server.js (global-setup builds it)
+ * on a COPY of the seeded data/app.db and speaks newline-delimited JSON-RPC to it, reading
+ * raw stdout, so anything else printed there fails the test.
+ */
+describe('mcp-server (e2e, stdio)', () => {
+  const root = join(import.meta.dirname, '..');
+  const missing = '00000000-0000-4000-8000-000000000000';
+  let dir: string;
+  let db: SqlClient;
+  let proc: ChildProcess;
+  let stderr = '';
+  const stdoutLines: string[] = [];
+  const pending = new Map<number, (message: Record<string, unknown>) => void>();
+  let nextId = 0;
+
+  type ToolResult = { isError?: boolean; content: { text: string }[] };
+
+  const send = (message: object) =>
+    proc.stdin!.write(`${JSON.stringify({ jsonrpc: '2.0', ...message })}\n`);
+  const request = (method: string, params: object = {}) =>
+    new Promise<Record<string, unknown>>((resolve) => {
+      const id = ++nextId;
+      pending.set(id, resolve);
+      send({ id, method, params });
+    });
+  const call = async (name: string, args: object = {}) =>
+    (await request('tools/call', { name, arguments: args }))
+      .result as ToolResult;
+  const text = (r: ToolResult) => r.content.map((c) => c.text).join('');
+  const json = <T>(r: ToolResult): T => {
+    expect(r.isError, text(r)).toBeFalsy();
+    return JSON.parse(text(r)) as T;
+  };
+  const scalar = async (sql: string, args: string[] = []) =>
+    (await db.execute({ sql, args })).rows[0]?.[0];
+  /** A TEXT value (an id) from the database copy. */
+  const textOf = async (sql: string, args: string[] = []) =>
+    (await scalar(sql, args)) as string;
+
+  let serverInfo: unknown;
+
+  beforeAll(async () => {
+    // Under data/ (git-ignored), never data/app.db itself.
+    dir = mkdtempSync(join(root, 'data', 'mcp-e2e-'));
+    const file = join(dir, 'app.db');
+    copyFileSync(join(root, 'data', 'app.db'), file);
+    db = createClient({ url: `file:${file}` });
+    proc = spawn(process.execPath, [join(root, 'dist', 'mcp-server.js')], {
+      env: { ...process.env, DATABASE_URL: `file:${file}` },
+      stdio: ['pipe', 'pipe', 'pipe'],
+    });
+    proc.stderr!.on('data', (chunk: Buffer) => (stderr += chunk.toString()));
+    createInterface({ input: proc.stdout! }).on('line', (line) => {
+      stdoutLines.push(line);
+      const message = JSON.parse(line) as Record<string, unknown>;
+      pending.get(message.id as number)?.(message);
+    });
+    const init = await request('initialize', {
+      protocolVersion: LATEST_PROTOCOL_VERSION,
+      capabilities: {},
+      clientInfo: { name: 'e2e', version: '1.0.0' },
+    });
+    serverInfo = (init.result as { serverInfo: unknown }).serverInfo;
+    send({ method: 'notifications/initialized' });
+  });
+
+  afterAll(() => {
+    proc?.kill();
+    db?.close();
+    rmSync(dir, { recursive: true, force: true });
+  });
+
+  it('identifies as notes-db 0.1.0 and lists exactly the eight tools', async () => {
+    expect(serverInfo).toEqual({ name: 'notes-db', version: '0.1.0' });
+    const { tools } = (await request('tools/list')).result as {
+      tools: { name: string }[];
+    };
+    expect(tools.map((t) => t.name).sort()).toEqual([
+      'create-note',
+      'describe-table',
+      'list-tables',
+      'notes-for-user',
+      'query',
+      'share-note',
+      'unshare-note',
+      'update-note',
+    ]);
+  });
+
+  it('writes only JSON-RPC to stdout, and its diagnostics to stderr', () => {
+    expect(stdoutLines.length).toBeGreaterThan(0);
+    for (const line of stdoutLines) {
+      expect(JSON.parse(line)).toMatchObject({ jsonrpc: '2.0' });
+    }
+    expect(stderr).toContain('mcp-server: ready (');
+  });
+
+  it('reads: list-tables, describe-table, query with a limit', async () => {
+    const tables = json<{ table: string; rows: number }[]>(
+      await call('list-tables'),
+    );
+    expect(tables).toEqual([
+      {
+        table: 'users',
+        rows: Number(await scalar('select count(*) from users')),
+      },
+      {
+        table: 'notes',
+        rows: Number(await scalar('select count(*) from notes')),
+      },
+      {
+        table: 'note_shares',
+        rows: Number(await scalar('select count(*) from note_shares')),
+      },
+    ]);
+    const columns = json<{ name: string; primaryKey: boolean }[]>(
+      await call('describe-table', { table: 'note_shares' }),
+    );
+    expect(columns.filter((c) => c.primaryKey).map((c) => c.name)).toEqual([
+      'note_id',
+      'user_id',
+    ]);
+    const res = json<{ rows: { id: string }[]; rowCount: number }>(
+      await call('query', { sql: 'select id from notes', limit: 3 }),
+    );
+    expect(res.rowCount).toBe(3);
+    expect(res.rows).toHaveLength(3);
+    expect(res.rows[0]).toHaveProperty('id');
+  });
+
+  it('query refuses writes with READ_ONLY, including one hidden in a WITH', async () => {
+    const before = await scalar('select count(*) from notes');
+    for (const sql of [
+      'delete from notes',
+      'select 1; delete from notes',
+      'with x as (select 1) delete from notes',
+      'pragma query_only = 0',
+    ]) {
+      const r = await call('query', { sql });
+      expect(r.isError, sql).toBe(true);
+      expect(text(r)).toMatch(/^READ_ONLY: /);
+    }
+    expect(await scalar('select count(*) from notes')).toBe(before);
+  });
+
+  it('notes-for-user marks access; an unknown user is NOT_FOUND', async () => {
+    const userId = await textOf(
+      'select user_id from note_shares order by note_id limit 1',
+    );
+    const all = json<{ access: string; ownerId: string }[]>(
+      await call('notes-for-user', { userId }),
+    );
+    expect(all.filter((n) => n.access === 'owner')).toHaveLength(
+      Number(
+        await scalar('select count(*) from notes where owner_id = ?', [userId]),
+      ),
+    );
+    expect(all.filter((n) => n.access === 'shared')).toHaveLength(
+      Number(
+        await scalar('select count(*) from note_shares where user_id = ?', [
+          userId,
+        ]),
+      ),
+    );
+    const owned = json<{ access: string }[]>(
+      await call('notes-for-user', { userId, include: 'owned' }),
+    );
+    expect(owned.every((n) => n.access === 'owner')).toBe(true);
+    const r = await call('notes-for-user', { userId: missing });
+    expect(text(r)).toMatch(/^NOT_FOUND: /);
+  });
+
+  it('create-note: R1 owner must exist, R3 dueAt stored as UTC', async () => {
+    const ownerId = await textOf('select id from users limit 1');
+    const created = json<{ id: string; status: string; body: string }>(
+      await call('create-note', {
+        ownerId,
+        title: '  From e2e  ',
+        dueAt: '2026-11-01T09:00:00+08:00',
+      }),
+    );
+    expect(created).toMatchObject({ status: 'open', body: '' });
+    expect(
+      await scalar(`select title || '|' || due_at from notes where id = ?`, [
+        created.id,
+      ]),
+    ).toBe('From e2e|2026-11-01T01:00:00.000Z');
+    const r = await call('create-note', { ownerId: missing, title: 'x' });
+    expect(r.isError).toBe(true);
+    expect(text(r)).toMatch(/^RULE_VIOLATION: /);
+  });
+
+  it('update-note: R2 a done note can only be reopened; unknown id NOT_FOUND', async () => {
+    const id = await textOf(
+      "select id from notes where status = 'done' limit 1",
+    );
+    const refused = await call('update-note', {
+      id,
