diff --git a/src/mcp-server.ts b/src/mcp-server.ts
new file mode 100644
index 0000000..879296a
--- /dev/null
+++ b/src/mcp-server.ts
@@ -0,0 +1,40 @@
+// `pnpm mcp`: the notes-db MCP server (specs/mcp.md) over stdio, on the SQLite file in
+// DATABASE_URL (else ./data/app.db). Not a Nest app: it builds only what the tools need.
+// Stdout belongs to the protocol, so every diagnostic goes to stderr.
+import { createClient } from '@libsql/client';
+import { StdioServerTransport } from '@modelcontextprotocol/server/stdio';
+import { existsSync } from 'node:fs';
+import { validateEnv } from './config/env.schema.js';
+import { connectSqlite } from './database/connect.js';
+import { createNotesDbServer } from './mcp/notes-db.server.js';
+import { DrizzleNotesRepository } from './notes/notes.drizzle-repository.js';
+import { NotesService } from './notes/notes.service.js';
+
+const env = validateEnv(process.env);
+const url = env.DATABASE_URL ?? 'file:./data/app.db';
+
+// connectSqlite creates a missing file (and its folder), which would serve an EMPTY database
+// with no tables. Started from the wrong working directory, that is the likely mistake.
+const file = url.slice('file:'.length).split('?')[0];
+if (!existsSync(file)) {
+  console.error(
+    `mcp-server: database file not found: ${file} (cwd ${process.cwd()}). ` +
+      'Set DATABASE_URL to an absolute file: URL, or start from the project folder.',
+  );
+  process.exit(1);
+}
+
+const connection = await connectSqlite(url);
+// The `query` tool's connection: SQLite refuses every write on it, whatever the SQL hides.
+const reader = createClient({ url });
+await reader.execute('PRAGMA query_only = ON');
+
+const notesRepository = new DrizzleNotesRepository(connection.db);
+const server = createNotesDbServer({
+  db: connection.db,
+  reader,
+  notes: new NotesService(notesRepository),
+  notesRepository,
+});
+await server.connect(new StdioServerTransport());
+console.error(`mcp-server: ready (${url})`);
diff --git a/src/mcp/notes-db.server.ts b/src/mcp/notes-db.server.ts
new file mode 100644
index 0000000..1e41478
--- /dev/null
+++ b/src/mcp/notes-db.server.ts
@@ -0,0 +1,250 @@
+import type { Client as SqlClient } from '@libsql/client';
+import { McpServer, type CallToolResult } from '@modelcontextprotocol/server';
+import { and, asc, count, eq, sql } from 'drizzle-orm';
+import { z } from 'zod';
+import { DomainError, NotFoundError } from '../common/errors/domain-error.js';
+import type { Db } from '../database/database.types.js';
+import { noteShares } from '../notes/note-shares.table.js';
+import {
+  CreateNoteSchema,
+  NoteListQuerySchema,
+  NoteSchema,
+  UpdateNoteSchema,
+} from '../notes/note.schema.js';
+import type { NotesRepository } from '../notes/notes.repository.js';
+import type { NotesService } from '../notes/notes.service.js';
+import { notes } from '../notes/notes.table.js';
+import { users } from '../users/users.table.js';
+import { isSingleReadStatement } from './read-only-sql.js';
+
+/** What the tools need. The write tools go through NotesService, so they keep its rules. */
+export interface NotesDbDeps {
+  db: Db;
+  /** A connection with `PRAGMA query_only = ON`: the only one the `query` tool may use. */
+  reader: SqlClient;
+  notes: NotesService;
+  notesRepository: NotesRepository;
+}
+
+const TABLES = { users, notes, note_shares: noteShares } as const;
+const TableName = z.enum(['users', 'notes', 'note_shares']);
+
+const ok = (value: unknown): CallToolResult => ({
+  content: [{ type: 'text', text: JSON.stringify(value) }],
+});
+
+/** A tool error the model can read: `<CODE>: <message>` (specs/mcp.md). */
+const toolError = (code: string, message: string): CallToolResult => ({
+  content: [{ type: 'text', text: `${code}: ${message}` }],
+  isError: true,
+});
+
+/** Runs a tool body. A DomainError is the model's to read; anything else is a real failure. */
+async function run(body: () => Promise<unknown>): Promise<CallToolResult> {
+  try {
+    return ok(await body());
+  } catch (error) {
+    if (error instanceof DomainError)
+      return toolError(error.code, error.message);
+    throw error;
+  }
+}
+
+/** True for SQLite's refusal to write on a query_only connection. */
+const isReadOnlyRefusal = (error: unknown) =>
+  (error as { code?: unknown } | null)?.code === 'SQLITE_READONLY';
+
+/** The MCP server of specs/mcp.md, on an open database. The caller connects a transport. */
+export function createNotesDbServer(deps: NotesDbDeps): McpServer {
+  const { db, reader } = deps;
+  const server = new McpServer({ name: 'notes-db', version: '0.1.0' });
+
+  server.registerTool(
+    'list-tables',
+    {
+      description:
+        'The tables of the notes database (users, notes, note_shares) with their row counts.',
+      inputSchema: z.object({}),
+      annotations: { readOnlyHint: true },
+    },
+    () =>
+      run(async () =>
+        Promise.all(
+          Object.entries(TABLES).map(async ([table, t]) => {
+            const [{ rows }] = await db.select({ rows: count() }).from(t);
+            return { table, rows };
+          }),
+        ),
+      ),
+  );
+
+  server.registerTool(
+    'describe-table',
+    {
+      description:
+        'The columns of one table: name, SQL type, NOT NULL, primary key.',
+      inputSchema: z.object({ table: TableName }),
+      annotations: { readOnlyHint: true },
+    },
+    ({ table }) =>
+      run(async () => {
+        const columns = await db.all<{
+          name: string;
+          type: string;
+          notnull: number;
+          pk: number;
+        }>(
+          sql`select name, type, "notnull", pk from pragma_table_info(${table})`,
+        );
+        return columns.map((c) => ({
+          name: c.name,
+          type: c.type,
+          notNull: c.notnull === 1,
+          primaryKey: c.pk > 0,
+        }));
+      }),
+  );
+
+  server.registerTool(
+    'query',
+    {
+      description:
+        'Run ONE read-only SQL statement (SELECT, or WITH … SELECT) on the SQLite database. ' +
+        'Columns are snake_case (owner_id, due_at). Returns at most `limit` rows.',
+      inputSchema: z.object({
+        sql: z.string().min(1),
+        limit: z.number().int().min(1).max(200).default(50),
+      }),
+      annotations: { readOnlyHint: true },
+    },
+    async ({ sql: text, limit }) => {
+      if (!isSingleReadStatement(text)) {
+        return toolError(
+          'READ_ONLY',
+          'only a single SELECT (or WITH … SELECT) statement is allowed',
+        );
+      }
+      try {
+        const result = await reader.execute(text);
+        const rows = result.rows
+          .slice(0, limit)
+          .map((row) =>
+            Object.fromEntries(result.columns.map((c, i) => [c, row[i]])),
+          );
+        return ok({ rows, rowCount: rows.length });
+      } catch (error) {
+        // A write that got past the lexical check (e.g. `WITH … DELETE`) is refused here.
+        if (isReadOnlyRefusal(error)) {
+          return toolError('READ_ONLY', 'the statement would write');
+        }
+        throw error;
+      }
+    },
+  );
+
+  server.registerTool(
+    'notes-for-user',
+    {
+      description:
+        "A user's notes: the ones they own and/or the ones shared with them, each marked " +
+        "access 'owner' or 'shared'.",
+      inputSchema: z.object({
+        userId: z.string().uuid(),
+        include: z.enum(['owned', 'shared', 'all']).default('all'),
+        status: NoteListQuerySchema.shape.status,
+      }),
+      annotations: { readOnlyHint: true },
+    },
+    ({ userId, include, status }) =>
+      run(async () => {
+        if (!(await deps.notesRepository.findUser(userId))) {
+          throw new NotFoundError('User', userId);
+        }
+        const byStatus = status ? eq(notes.status, status) : undefined;
+        const order = [asc(notes.createdAt), asc(notes.id)];
+        const owned =
+          include === 'shared'
+            ? []
+            : await db
+                .select()
+                .from(notes)
+                .where(and(eq(notes.ownerId, userId), byStatus))
+                .orderBy(...order);
+        const shared =
+          include === 'owned'
+            ? []
+            : await db
+                .select({ note: notes })
+                .from(noteShares)
+                .innerJoin(notes, eq(notes.id, noteShares.noteId))
+                .where(and(eq(noteShares.userId, userId), byStatus))
+                .orderBy(...order);
+        return [
+          ...owned.map((note) => ({ ...note, access: 'owner' as const })),
+          ...shared.map(({ note }) => ({ ...note, access: 'shared' as const })),
+        ];
+      }),
+  );
+
+  server.registerTool(
+    'create-note',
+    {
+      description:
+        'Create an open note owned by an existing user. dueAt: an ISO datetime with offset.',
+      inputSchema: CreateNoteSchema.omit({ status: true }),
+    },
+    // Parsed again by the full create schema so its defaults (status 'open') apply.
+    (input) => run(() => deps.notes.create(CreateNoteSchema.parse(input))),
+  );
+
+  server.registerTool(
+    'update-note',
+    {
+      description:
+        'Change a note: at least one of title, body, status, dueAt (null clears it). ' +
+        "A done note can only be reopened with status 'open' alone.",
+      inputSchema: z
+        .object({ id: NoteSchema.shape.id, ...UpdateNoteSchema.shape })
+        // `id` plus at least one field (absent optional keys are not added by zod).
+        .refine((input) => Object.keys(input).length > 1, {
+          message: 'Provide at least one field to update',
+        }),
+    },
+    ({ id, ...patch }) => run(() => deps.notes.update(id, patch)),
+  );
+
+  const shareInput = z.object({
+    noteId: NoteSchema.shape.id,
+    userId: z.string().uuid(),
+  });
+
+  server.registerTool(
+    'share-note',
+    {
+      description:
+        'Share a note with a user (not its owner). Sharing twice is fine.',
+      inputSchema: shareInput,
+      annotations: { idempotentHint: true },
+    },
+    ({ noteId, userId }) =>
+      run(async () => {
+        await deps.notes.share(noteId, userId);
+        return { noteId, userId, shared: true };
+      }),
+  );
+
+  server.registerTool(
+    'unshare-note',
+    {
+      description: 'Stop sharing a note with a user.',
+      inputSchema: shareInput,
+    },
+    ({ noteId, userId }) =>
+      run(async () => {
+        await deps.notes.unshare(noteId, userId);
+        return { noteId, userId, shared: false };
+      }),
+  );
+
+  return server;
+}
