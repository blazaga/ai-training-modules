@@ -48,4 +48,15 @@ export class NotesTools {
   ): Promise<ToolResult> {
     return runTool(() => this.notes.create(input));
   }
+
+  @Tool({
+    name: 'publish-note',
+    description:
+      'Publish a note by its id (a UUID): sets status to published. Rule: a published note needs a non-empty body, so publishing a note whose body is empty fails with RULE_VIOLATION. Publishing cannot be undone.',
+    parameters: z.object({ id: z.string().uuid() }),
+  })
+  publishNote(@Payload() { id }: { id: string }): Promise<ToolResult> {
+    // Through the service, so R5 is enforced in one place, not re-implemented here.
+    return runTool(() => this.notes.update(id, { status: 'published' }));
+  }
 }
