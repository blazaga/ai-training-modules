+  it('publish-note publishes through the service', async () => {
+    const created = await call('create-note', {
+      title: 'To publish',
+      body: 'hi',
+    });
+    const { id } = JSON.parse(created.content[0].text) as { id: string };
+    const published = await call('publish-note', { id });
+    expect(published.isError ?? false).toBe(false);
+    expect(JSON.parse(published.content[0].text)).toMatchObject({
+      id,
+      status: 'published',
+    });
+  });
+
+  it('publish-note with an empty body is a RULE_VIOLATION tool error (R5)', async () => {
+    const created = await call('create-note', { title: 'Empty' });
+    const { id } = JSON.parse(created.content[0].text) as { id: string };
+    const result = await call('publish-note', { id });
+    expect(result.isError).toBe(true);
+    expect(result.content[0].text).toMatch(
+      /^RULE_VIOLATION: A published note needs a non-empty body/,
+    );
+    const stored = await call('get-note', { id });
+    expect(JSON.parse(stored.content[0].text).status).toBe('draft');
+  });
+
+  it('publish-note with an unknown id is a NOT_FOUND tool error', async () => {
+    const result = await call('publish-note', {
+      id: '00000000-0000-4000-8000-000000000000',
+    });
+    expect(result.isError).toBe(true);
+    expect(result.content[0].text).toMatch(/^NOT_FOUND:/);
+  });
