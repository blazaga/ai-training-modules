+import type { z } from 'zod';
+import type { OrderResponseSchema, OrderSchema } from '../order.schema.js';
+
+/** Derived from the schemas: never hand-write fields here. */
+export type Order = z.infer<typeof OrderSchema>;
+
+/** A Order without its private fields: the only shape that leaves the API. */
+export type OrderResponse = z.infer<typeof OrderResponseSchema>;
diff --git a/src/orders/order.schema.ts b/src/orders/order.schema.ts
new file mode 100644
index 0000000..aeae09c
--- /dev/null
+++ b/src/orders/order.schema.ts
@@ -0,0 +1,54 @@
+import { z } from 'zod';
+import { patchSchema } from '../common/schemas/patch-schema.js';
+
+/**
+ * Single source of truth for a Order AS STORED: validation, TypeScript types
+ * and the OpenAPI schema all derive from these definitions. Change fields HERE only.
+ */
+export const OrderSchema = z.object({
+  id: z.string().uuid(),
+  item: z.string().min(1).max(200),
+  // Spec O1: a whole number 1-100 (payload-only, so it lives here → 400). z.number()
+  // also refuses a numeric string such as "2".
+  quantity: z.number().int().min(1).max(100).default(1),
+  status: z.enum(['open', 'fulfilled']).default('open'),
+  createdAt: z.string().datetime(),
+  updatedAt: z.string().datetime(),
+});
+
+/**
+ * Stored but never RETURNED and never ACCEPTED from a client (a password or
+ * secret hash). Responses are parsed through OrderResponseSchema, which
+ * strips these. A test checks that no response carries them.
+ */
+const PRIVATE = {} as const;
+
+/**
+ * Returned to clients but never ACCEPTED from them: the server sets these, usually
+ * through actions (e.g. `status` only changes via POST /:id/activate).
+ */
+const SERVER_OWNED = {} as const;
+
+/** What every endpoint returns. */
+export const OrderResponseSchema = OrderSchema.omit(PRIVATE);
+
+/**
+ * Client-settable fields, UNREFINED. Zod 4 throws on .omit()/.partial() of a
+ * refined object, so derive from this and attach .refine() last.
+ */
+const OrderFields = OrderSchema.omit({
+  id: true,
+  createdAt: true,
+  updatedAt: true,
+  ...PRIVATE,
+  ...SERVER_OWNED,
+});
+
+/** POST body. */
+export const CreateOrderSchema = OrderFields;
+
+/**
+ * PATCH body: any subset of the create fields, never empty, and WITHOUT defaults
+ * (see patchSchema: .partial() would overwrite stored values with defaults).
+ */
+export const UpdateOrderSchema = patchSchema(OrderFields);
