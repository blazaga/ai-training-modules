# Names and safe defaults only. Never put a real secret in this file.
# Every variable here must exist in src/config/env.schema.ts (and vice versa).
NODE_ENV=development
PORT=3000
# Unset: docs on, except when NODE_ENV=production.
SWAGGER_ENABLED=true
# The SQLite database file, as a libSQL URL. data/app.db ships seeded and migrated
# (`npm run db:seed` rebuilds it). Without this line the app still uses data/app.db in development.
DATABASE_URL=file:./data/app.db

