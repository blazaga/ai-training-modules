# Names and safe defaults only. Never put a real secret in this file.
# Every variable here must exist in src/config/env.schema.ts (and vice versa).
NODE_ENV=development
PORT=3000
# Unset: docs on, except when NODE_ENV=production.
SWAGGER_ENABLED=true
# Postgres URL (see docker-compose.yml). Leave unset to use an in-memory PGlite in dev.
# Real values never go in this file; this one matches the local compose file only.
# Uncomment after `docker compose up -d db`, then run `pnpm db:migrate`:
# DATABASE_URL=postgres://app:app-local-only@localhost:5432/app

# ch08: host names the MCP endpoint accepts (comma-separated). Unset = localhost only.
# MCP_ALLOWED_HOSTS=localhost,mcp.example.com
