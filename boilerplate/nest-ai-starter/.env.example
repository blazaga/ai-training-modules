# Names and safe defaults only. Never put a real secret in this file.
# Every variable here must exist in src/config/env.schema.ts (and vice versa).
NODE_ENV=development
PORT=3000
# Unset: docs on, except when NODE_ENV=production.
SWAGGER_ENABLED=true
# The SQLite database file, as a libSQL URL. `pnpm db:migrate` creates and migrates it; the
# app then uses it. Remove the line to use an in-memory database instead (gone on restart).
DATABASE_URL=file:./data/app.db

# ch08: host names the MCP endpoint accepts (comma-separated). Unset = localhost only.
# MCP_ALLOWED_HOSTS=localhost,mcp.example.com
