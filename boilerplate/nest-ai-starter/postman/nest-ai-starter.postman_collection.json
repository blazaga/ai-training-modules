              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notes", "{{noteId}}"]
            },
            "description": "A rule that needs stored state lives in the service and answers 422. Delete the rule in the service and this test goes red: that is the chapter 01 mutation check.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"published\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
