    {
      "id": "fe9e73f4-2f23-5c5e-bb90-a49b280d8753",
      "name": "09 · Rotate mid-session (lite module 6)",
      "description": "Rotate the secret, then call whoami with the OLD one: it fails at once. The new one works.",
      "item": [
        {
          "id": "c99b732d-8c74-59ec-bb70-77cafc2991e4",
          "name": "Rotate credentials",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}/credentials",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "devices", "{{deviceId}}", "credentials"]
            },
            "description": "Same accessKeyId, new secret. The OLD secret stays in `secret` for the next request; the new one goes to `rotatedSecret`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('same key id, new secret', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const c = pm.response.json();",
                  "  pm.expect(c.accessKeyId).to.eql(pm.collectionVariables.get('accessKeyId'));",
                  "  pm.expect(c.secret).to.not.eql(pm.collectionVariables.get('secret'));",
                  "  pm.collectionVariables.set('rotatedSecret', c.secret);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "id": "6cba0e96-f95b-5112-9371-b236e292bd2e",
          "name": "whoami with the OLD secret → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "X-Access-Key-Id",
                "value": "{{accessKeyId}}"
              },
              {
                "key": "X-Secret-Key",
                "value": "{{secret}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp",
              "host": ["{{baseUrl}}"],
              "path": ["mcp"]
            },
            "description": "The rotation took effect on the very next call.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 8,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"whoami\",\n    \"arguments\": {}\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rpc = () => { const t = pm.response.text(); const d = t.split('\\n').find((l) => l.startsWith('data: ')); return JSON.parse(d ? d.slice(6) : t); };",
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "id": "64bcbdca-36bc-5e89-b1d2-80c16825c883",
          "name": "whoami with the NEW secret",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "X-Access-Key-Id",
                "value": "{{accessKeyId}}"
              },
              {
                "key": "X-Secret-Key",
                "value": "{{rotatedSecret}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp",
              "host": ["{{baseUrl}}"],
              "path": ["mcp"]
            },
            "description": "Uses `rotatedSecret`, then promotes it to `secret`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 9,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"whoami\",\n    \"arguments\": {}\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rpc = () => { const t = pm.response.text(); const d = t.split('\\n').find((l) => l.startsWith('data: ')); return JSON.parse(d ? d.slice(6) : t); };",
                  "pm.test('200 and not a tool error', () => { pm.response.to.have.status(200); pm.expect(rpc().result.isError).to.not.eql(true); });",
                  "pm.collectionVariables.set('secret', pm.collectionVariables.get('rotatedSecret'));",
                  "pm.collectionVariables.set('rotatedSecret', '');"
                ]
              }
            }
          ]
        }
      ]
