            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 draft', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('draft'); });",
                  "pm.collectionVariables.set('noteId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "id": "f05b20a3-9f7e-5d86-89fc-0d5a7044d009",
          "name": "Publish it → 422 RULE_VIOLATION",
