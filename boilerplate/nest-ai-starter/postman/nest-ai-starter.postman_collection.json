{
  "info": {
    "_postman_id": "c74dabb4-902e-5f8a-a4c6-401f45cc8254",
    "name": "nest-ai-starter",
    "description": "The REST calls of module 1: users, notes and sharing, on the seeded data/app.db. Folders work once your agent has built that resource. Run the folders in order: later requests use ids the earlier ones store.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "id": "b06f2ece-5d26-5cfb-8384-858826298676",
      "name": "00 · Setup (module 1)",
      "description": "Is the app up? Run this first.",
      "item": [
        {
          "id": "ece7d0de-9e82-5a31-ba43-5c258bb360f1",
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "The unversioned health route."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 {status: ok}', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "48a13dc5-9bf6-5fab-9f54-2e0fe662e306",
      "name": "01 · Users (module 1)",
      "description": "The users resource on the seeded data/app.db (25 users). These requests write to your database; `pnpm db:seed` rebuilds it from scratch.",
      "item": [
        {
          "id": "ffb363cb-db31-5652-a323-741a476e1230",
          "name": "List users (seeded)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Paged list: { items, total, limit, offset }."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('seeded users are there', () => pm.expect(pm.response.json().total).to.be.above(0));",
                  "pm.collectionVariables.set('friendId', pm.response.json().items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "id": "07534845-99a7-50e1-bc2f-b39c22acd792",
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "Email stored lower-case; name trimmed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"Postman.{{$timestamp}}@Example.com\",\n  \"name\": \"  Postman User  \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('email lower-cased', () => pm.expect(pm.response.json().email).to.eql(pm.response.json().email.toLowerCase()));",
                  "pm.collectionVariables.set('userId', pm.response.json().id);",
                  "pm.collectionVariables.set('userEmail', pm.response.json().email);"
                ]
              }
            }
          ]
        },
        {
          "id": "51597639-743d-53a7-ba7d-e8920f0d3481",
          "name": "Duplicate email → 409 (R1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "The same email again collides (emails are compared lower-case).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"name\": \"Twin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "id": "cb0a5cea-dbde-5a43-b709-c67ebda53225",
          "name": "Get user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            },
            "description": "One user by id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "id": "3380a612-c80e-5571-aef1-40773920520b",
          "name": "Rename user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            },
            "description": "PATCH changes only what you send.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Renamed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('renamed', () => pm.expect(pm.response.json().name).to.eql('Renamed'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "83dae31d-3ca0-5dc7-9cf1-cc208344a408",
      "name": "02 · Notes and sharing (module 1)",
      "description": "The notes (TODO items) and who they are shared with. Run 01 first: it sets userId and friendId. These requests write to your database; `pnpm db:seed` rebuilds it.",
      "item": [
        {
          "id": "16de6fbb-8ede-5ecb-be1d-3257cccf435e",
          "name": "List open notes (seeded)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes?status=open&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notes"],
              "query": [
                {
                  "key": "status",
                  "value": "open"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Filters combine with AND: ownerId, sharedWith, status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('all open', () => pm.response.json().items.forEach((n) => pm.expect(n.status).to.eql('open')));"
                ]
              }
            }
          ]
        },
        {
          "id": "fc16e72f-5974-52c8-a274-7eb0c35a6267",
          "name": "Create note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notes"]
            },
            "description": "dueAt with an offset is stored as UTC toISOString().",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerId\": \"{{userId}}\",\n  \"title\": \"Buy milk\",\n  \"dueAt\": \"2026-11-01T09:00:00+08:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('defaults and UTC dueAt', () => { const n = pm.response.json(); pm.expect(n.status).to.eql('open'); pm.expect(n.dueAt).to.eql('2026-11-01T01:00:00.000Z'); });",
                  "pm.collectionVariables.set('noteId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "id": "d55784ea-8928-58de-910e-4891ba3d40a3",
          "name": "Unknown owner → 422 (R1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notes"]
            },
            "description": "The owner must exist.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerId\": \"00000000-0000-4000-8000-000000000000\",\n  \"title\": \"x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "id": "7680ed96-2504-5fdc-9b77-6fc19c167706",
          "name": "Mark done",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes/{{noteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notes", "{{noteId}}"]
            },
            "description": "Status open → done.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "id": "ec5dfeeb-e60e-5257-bef0-c6935b7cc4d8",
          "name": "Edit a done note → 422 (R2)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes/{{noteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notes", "{{noteId}}"]
            },
            "description": "A done note can only be reopened.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Changed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "id": "ed878efd-4f33-59c2-bc5c-a3c0bf7cdb3e",
          "name": "Reopen",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes/{{noteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notes", "{{noteId}}"]
            },
            "description": "Reopening is the one edit a done note allows.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "id": "9c8b07a0-98c3-52c3-be1a-77fa15321fe4",
          "name": "Share with a friend",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes/{{noteId}}/shares/{{friendId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "notes",
                "{{noteId}}",
                "shares",
                "{{friendId}}"
              ]
            },
            "description": "Idempotent: sharing twice is still 204."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "id": "697bced4-0a43-532f-af6f-85c54d70ca1d",
          "name": "Who it is shared with",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes/{{noteId}}/shares",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notes", "{{noteId}}", "shares"]
            },
            "description": "{ items: User[] }."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('the friend is listed', () => pm.expect(pm.response.json().items.map((u) => u.id)).to.include(pm.collectionVariables.get('friendId')));"
                ]
              }
            }
          ]
        },
        {
          "id": "4a91df7f-3395-532d-af25-a505601cc9da",
          "name": "Notes shared with the friend",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes?sharedWith={{friendId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notes"],
              "query": [
                {
                  "key": "sharedWith",
                  "value": "{{friendId}}"
                }
              ]
            },
            "description": "The sharedWith filter."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('includes the note', () => pm.expect(pm.response.json().items.map((n) => n.id)).to.include(pm.collectionVariables.get('noteId')));"
                ]
              }
            }
          ]
        },
        {
          "id": "057677bf-08d6-54ee-a564-e3a4a4bbbc9f",
          "name": "Share with the owner → 422 (R4)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes/{{noteId}}/shares/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "notes",
                "{{noteId}}",
                "shares",
                "{{userId}}"
              ]
            },
            "description": "Never shared with its own owner."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "id": "75253735-e3ff-54aa-8fb2-80cb57ecc7d4",
          "name": "Unshare",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes/{{noteId}}/shares/{{friendId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "notes",
                "{{noteId}}",
                "shares",
                "{{friendId}}"
              ]
            },
            "description": "Unsharing again is 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "id": "3d83ae91-b897-5594-ae65-18ce110e28e8",
          "name": "Delete a user who owns notes → 409 (R2 of users)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{userId}}"]
            },
            "description": "RESTRICT: the owner still has a note."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "id": "39986d3b-7d52-5ac8-8adc-2634de2fb4f8",
          "name": "Delete the note",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes/{{noteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notes", "{{noteId}}"]
            },
            "description": "Its shares go with it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "friendId",
      "value": ""
    },
    {
      "key": "noteId",
      "value": ""
    }
  ]
}
