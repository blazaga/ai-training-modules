    {
      "id": "05bd0597-a410-56c8-bf89-195df477f750",
      "name": "06 · Notes over REST (lite module 4)",
      "description": "The same rule as the MCP tool, at the HTTP boundary: a published note needs a non-empty body.",
      "item": [
        {
          "id": "48a07907-501c-5e7d-962a-1bf09b74a686",
          "name": "Create note (draft, empty body)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notes"]
            },
            "description": "Defaults: status `draft`, body empty.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"from postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
