{
  "name": "nest-ai-starter",
  "version": "0.0.1",
  "description": "NestJS starter for building REST services with AI agents, skills and templates",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "resource:template": "node scripts/apply-resource-template.mjs",
    "check:ai-fill": "node scripts/check-ai-fill.mjs",
    "verify": "tsc --noEmit -p tsconfig.json && oxlint --type-aware src/ test/ && prettier --check \"src/**/*.ts\" \"test/**/*.ts\" && node scripts/check-ai-fill.mjs && node scripts/check-migrations.mjs && vitest run && vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/database/migrate.js",
    "check:migrations": "node scripts/check-migrations.mjs",
    "mcp:stdio": "node dist/mcp-stdio.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/microservices": "12.2.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@rekog/mcp-nest": "2.0.8",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "passport": "0.7.0",
    "passport-custom": "1.2.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
