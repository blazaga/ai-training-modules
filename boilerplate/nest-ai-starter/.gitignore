!.oxlintrc.json

# scratch dir of scripts/check-migrations.mjs
.drizzle-check/

# TypeScript incremental build cache
*.tsbuildinfo

# a local SQLite database (DATABASE_URL=file:./data/app.db) is data, never source
data/
*.db
*.db-journal
*.db-wal
*.db-shm
