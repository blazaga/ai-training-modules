# dependencies and build output
node_modules/
dist/
coverage/

# local environment: never commit real values (use .env.example for names)
.env
.env.*
!.env.example

# editor / OS
.DS_Store
.idea/
.vscode/
*.log

# Lint config. Re-included because a parent repo may ignore dot-json files.
!.oxlintrc.json

# scratch dir of scripts/check-migrations.mjs
.drizzle-check/

# TypeScript incremental build cache
*.tsbuildinfo

# local SQLite databases are data, never source
data/*
*.db
# ...except the seeded database the course ships (rebuild it with `npm run db:seed`)
!data/app.db
*.db-journal
*.db-wal
*.db-shm
